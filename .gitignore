# 1c-ninja-kit gitignore

# secrets / local IB
autumn-properties.json
env.json
.env
.dev.env
**/.cursor/mcp.json
**/components/1c-ninja-mcp/mcp.json
**/*password*
**/*.local.json

# e2e agent logs may contain paths — keep locally
logs/*
!logs/README.md
!logs/.gitkeep

# task state is per-machine: каркас задачи живёт в проекте, в kit не публикуется
/Задачи/

# caches / junk
.build/
**/__pycache__/
**/.browser-session.json
**/*.log
node_modules/
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# OS
desktop.ini

# build artifacts
/build/
repository.json

