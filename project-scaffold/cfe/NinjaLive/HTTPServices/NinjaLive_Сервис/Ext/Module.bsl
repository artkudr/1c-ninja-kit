#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПараметрыТела(Запрос)

	Значение = NinjaLive_JSON.РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЛимитИзПараметров(Параметры)

	Если Параметры.Свойство("limit") Тогда
		Возврат Параметры.limit;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ОтветОшибкиОперации(ИмяОперации, КодСостояния, ИнформацияОшибки)

	Кратко = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОшибки);
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("Подробно", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОшибки));

	ЗаписьЖурналаРегистрации(
		"NinjaLive." + ИмяОперации + ".Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		,
		ДанныеСобытия,
		Кратко);

	Возврат NinjaLive_JSON.ОтветОшибка(КодСостояния, Кратко);

КонецФункции

#КонецОбласти
