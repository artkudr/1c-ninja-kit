#Область ОбработчикиСобытий

// GET /version
//
Функция ВерсияGET(Запрос) // BSLLS:UnusedParameters-off

	Попытка
		Результат = Новый Структура;
		Результат.Вставить("version", NinjaLive_Расширения.ВерсияТекущего());
		Возврат NinjaLive_JSON.ОтветJSON(Результат);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ОтветОшибкиОперации("Версия", 400, ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// POST /query
//
Функция ЗапросPOST(Запрос)

	Попытка
		Параметры = ПараметрыТела(Запрос);
		Если Не Параметры.Свойство("query") Или Не ЗначениеЗаполнено(Параметры.query) Тогда
			Возврат NinjaLive_JSON.ОтветОшибка(400, "query is required");
		КонецЕсли;

		ПараметрыЗапроса = Неопределено;
		Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
			ПараметрыЗапроса = Параметры.parameters;
		КонецЕсли;

		Результат = NinjaLive_Запросы.ВыполнитьВыборку(
			Параметры.query,
			ПараметрыЗапроса,
			ЛимитИзПараметров(Параметры));
		Возврат NinjaLive_JSON.ОтветJSON(Результат);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ОтветОшибкиОперации("Запрос", 400, ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

