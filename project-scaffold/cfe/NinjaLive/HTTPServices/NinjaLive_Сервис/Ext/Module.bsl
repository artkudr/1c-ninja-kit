// POST /metadata-list
//
Функция СписокМетаданныхPOST(Запрос)

	Попытка
		Параметры = ПараметрыТела(Запрос);
		Если Не Параметры.Свойство("meta_type") Или Не ЗначениеЗаполнено(Параметры.meta_type) Тогда
			Возврат NinjaLive_JSON.ОтветОшибка(400, "meta_type is required");
		КонецЕсли;

		МаскаИмени = "";
		Если Параметры.Свойство("name_mask") Тогда
			МаскаИмени = Строка(Параметры.name_mask);
		КонецЕсли;

		Результат = NinjaLive_Метаданные.СписокКоллекции(
			Параметры.meta_type,
			МаскаИмени,
			ЛимитИзПараметров(Параметры));
		Возврат NinjaLive_JSON.ОтветJSON(Результат);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ОтветОшибкиОперации("Метаданные", 400, ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

// POST /metadata-structure
//
Функция СтруктураМетаданныхPOST(Запрос)

	Попытка
		Параметры = ПараметрыТела(Запрос);
		Если Не Параметры.Свойство("meta_type") Или Не Параметры.Свойство("name") Тогда
			Возврат NinjaLive_JSON.ОтветОшибка(400, "meta_type and name are required");
		КонецЕсли;

		Результат = NinjaLive_Метаданные.СтруктураОбъекта(Параметры.meta_type, Параметры.name);
		Если Результат = Неопределено Тогда
			Возврат NinjaLive_JSON.ОтветОшибка(404, "Metadata object not found");
		КонецЕсли;
		Возврат NinjaLive_JSON.ОтветJSON(Результат);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ОтветОшибкиОперации("Метаданные", 400, ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

