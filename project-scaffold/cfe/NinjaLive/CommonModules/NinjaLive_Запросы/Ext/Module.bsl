#Область ПрограммныйИнтерфейс

// Выполняет SELECT/ВЫБРАТЬ (пакет не режется). Лимит - через СхемаЗапроса на последний
// возвращающий SELECT: ПЕРВЫЕ = Лимит+1, либо Мин(уже было, Лимит+1).
// Если схема не разобралась - fallback курсор с обрывом, как в оригинале.
//
// Параметры:
//   ТекстЗапроса     - Строка - текст запроса
//   ПараметрыЗапроса - Структура, Неопределено - параметры запроса
//   Лимит            - Число - запрошенный лимит (≤0 или не задан → 100, максимум 1000)
//
// Возвращаемое значение:
//   Структура - columns, rows, total, truncated
//
Функция ВыполнитьВыборку(ТекстЗапроса, ПараметрыЗапроса, Лимит) Экспорт

	РабочийЛимит = НормализованныйЛимит(Лимит);
	ПроверитьПрефиксВыборки(ТекстЗапроса);

	ТекстДляВыполнения = ТекстЗапросаСЛимитом(ТекстЗапроса, РабочийЛимит);

	ЗапросВыборки = Новый Запрос(ТекстДляВыполнения);
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
			ЗапросВыборки.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	РезультатЗапроса = ЗапросВыборки.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	СтрокиРезультата = Новый Массив;
	Счетчик = 0;
	Усечено = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Счетчик >= РабочийЛимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		ЗначенияСтроки = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			ЗначенияСтроки.Добавить(NinjaLive_JSON.ПривестиЗначениеКJSON(Выборка[ИмяКолонки]));
		КонецЦикла;
		СтрокиРезультата.Добавить(ЗначенияСтроки);
		Счетчик = Счетчик + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", СтрокиРезультата);
	Результат.Вставить("total", Счетчик);
	Результат.Вставить("truncated", Усечено);
	Возврат Результат;

КонецФункции

// Проверяет синтаксис запроса через СхемаЗапроса без выполнения.
// Ошибка разбора → valid=Ложь, без проброса наружу.
//
// Параметры:
//   ТекстЗапроса - Строка - текст запроса
//
// Возвращаемое значение:
//   Структура - valid (булево), errors (массив строк)
//
Функция ПроверитьСинтаксис(ТекстЗапроса) Экспорт

	Ошибки = Новый Массив;
	Результат = Новый Структура;

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПолучитьТекстЗапроса();
		Результат.Вставить("valid", Истина);
		Результат.Вставить("errors", Ошибки);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Результат.Вставить("valid", Ложь);
		Ошибки.Добавить(ОписаниеОшибки());
		Результат.Вставить("errors", Ошибки);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализованныйЛимит(Лимит)

	ЛимитПоУмолчанию = 100;
	МаксимальныйЛимит = 1000;
	Если Лимит = Неопределено Или Лимит <= 0 Тогда
		Возврат ЛимитПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Лимит, МаксимальныйЛимит);

КонецФункции

Процедура ПроверитьПрефиксВыборки(ТекстЗапроса)

	ДлинаПрефикса = 10;
	ДлинаВыбрать = 7;
	ДлинаSelect = 6;
	Префикс = ВРег(Лев(СокрЛП(ТекстЗапроса), ДлинаПрефикса));
	Если Лев(Префикс, ДлинаВыбрать) <> "ВЫБРАТЬ" И Лев(Префикс, ДлинаSelect) <> "SELECT" Тогда
		ВызватьИсключение "Only SELECT queries allowed";
	КонецЕсли;

КонецПроцедуры

Функция ТекстЗапросаСЛимитом(ТекстЗапроса, Лимит)

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		УстановитьКоличествоЗаписейПоследнегоВыбора(СхемаЗапроса, Лимит + 1);
		Возврат СхемаЗапроса.ПолучитьТекстЗапроса();
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат ТекстЗапроса;
	КонецПопытки;

КонецФункции

Процедура УстановитьКоличествоЗаписейПоследнегоВыбора(СхемаЗапроса, КоличествоЗаписей)

	Пакет = СхемаЗапроса.ПакетЗапросов;
	Индекс = Пакет.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ЭлементПакета = Пакет.Получить(Индекс);
		Если ТипЗнч(ЭлементПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ЗначениеЗаполнено(ЭлементПакета.ТаблицаДляПомещения) Тогда
			Для Каждого ОператорВыбора Из ЭлементПакета.Операторы Цикл
				ТекущееКоличество = ОператорВыбора.КоличествоПолучаемыхЗаписей;
				Если ТекущееКоличество = Неопределено Тогда
					ОператорВыбора.КоличествоПолучаемыхЗаписей = КоличествоЗаписей;
				Иначе
					ОператорВыбора.КоличествоПолучаемыхЗаписей = Мин(ТекущееКоличество, КоличествоЗаписей);
				КонецЕсли;
			КонецЦикла;
			Возврат;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
