#Область ПрограммныйИнтерфейс

// Десериализует строку JSON в значение 1С.
// Пустая строка (тело POST без содержимого) даёт пустую Структуру, без исключения.
// Битый JSON пробрасывается наверх.
//
// Параметры:
//   СтрокаJSON - Строка - текст JSON
//
// Возвращаемое значение:
//   Произвольный - десериализованное значение либо пустая Структура
//
Функция РазобратьJSON(СтрокаJSON) Экспорт

	Если ЭтоПустойТекстJSON(СтрокаJSON) Тогда
		Возврат Новый Структура;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции

// Сериализует значение 1С в строку JSON платформенным ЗаписатьJSON.
// Имя экспорта не ЗаписатьJSON - коллизия с глобальным методом платформы.
//
// Параметры:
//   Значение - Произвольный - значение для сериализации
//
// Возвращаемое значение:
//   Строка - JSON
//
Функция СтрокаJSON(Значение) Экспорт

	ЗаписьДокументаJSON = Новый ЗаписьJSON;
	ЗаписьДокументаJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьДокументаJSON, Значение);
	Возврат ЗаписьДокументаJSON.Закрыть();

КонецФункции

// Формирует успешный HTTP-ответ с JSON-телом.
//
// Параметры:
//   Значение - Произвольный - значение для тела ответа
//
// Возвращаемое значение:
//   HTTPСервисОтвет - код 200, Content-Type application/json; charset=utf-8
//
Функция ОтветJSON(Значение) Экспорт

	КодУспешно = 200;
	Ответ = Новый HTTPСервисОтвет(КодУспешно);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(ПривестиЗначениеКJSON(Значение)));
	Возврат Ответ;

КонецФункции

// Формирует HTTP-ответ с ошибкой {error}. Тело - платформенный JSON, не склейка строк.
//
// Параметры:
//   КодСостояния - Число - HTTP-код
//   ТекстОшибки  - Строка - описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет
//
Функция ОтветОшибка(КодСостояния, ТекстОшибки) Экспорт

	ТелоОшибки = Новый Структура;
	ТелоОшибки.Вставить("error", ТекстОшибки);

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON(ТелоОшибки));
	Возврат Ответ;

КонецФункции

// Приводит значение к типу, пригодному для сериализации в JSON.
// Неопределено и NULL - ""; число/булево/строка/дата как есть;
// массив/структура/соответствие - рекурсия; иное - Строка().
//
// Параметры:
//   Значение - Произвольный - исходное значение
//
// Возвращаемое значение:
//   Произвольный - значение, пригодное для JSON
//
Функция ПривестиЗначениеКJSON(Значение) Экспорт

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПривестиЗначениеКJSON(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ПривестиЗначениеКJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Вставить(Строка(КлючИЗначение.Ключ), ПривестиЗначениеКJSON(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПустойТекстJSON(СтрокаJSON)

	Возврат Не ЗначениеЗаполнено(СокрЛП(СтрокаJSON));

КонецФункции

#КонецОбласти
