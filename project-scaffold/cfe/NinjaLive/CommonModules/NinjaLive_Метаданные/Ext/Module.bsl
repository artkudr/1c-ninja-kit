#Область ПрограммныйИнтерфейс

// Список объектов коллекции метаданных живой ИБ.
//
// Параметры:
//   ИмяКоллекции - Строка - идентификатор коллекции (Catalogs, Documents, …)
//   МаскаИмени   - Строка - подстрока имени или синонима; пусто - без фильтра
//   Лимит        - Число - ≤0 → 100, максимум 1000
//
// Возвращаемое значение:
//   Структура - items (name, full_name, synonym), returned, truncated
//
Функция СписокКоллекции(ИмяКоллекции, МаскаИмени, Лимит) Экспорт

	РабочийЛимит = НормализованныйЛимит(Лимит);
	Маска = ВРег(Строка(МаскаИмени));

	Попытка
		КоллекцияМетаданных = Метаданные[ИмяКоллекции];
	Исключение
		ВызватьИсключение "Unknown metadata type: " + ИмяКоллекции;
	КонецПопытки;

	Элементы = Новый Массив;
	Для Каждого ЭлементКоллекции Из КоллекцияМетаданных Цикл
		Если Не ПустаяСтрока(Маска)
			И СтрНайти(ВРег(ЭлементКоллекции.Имя), Маска) = 0
			И СтрНайти(ВРег(Строка(ЭлементКоллекции.Синоним)), Маска) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Описание = Новый Структура;
		Описание.Вставить("name", ЭлементКоллекции.Имя);
		Описание.Вставить("full_name", ЭлементКоллекции.ПолноеИмя());
		Описание.Вставить("synonym", Строка(ЭлементКоллекции.Синоним));
		Элементы.Добавить(Описание);
		Если Элементы.Количество() >= РабочийЛимит Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("returned", Элементы.Количество());
	Результат.Вставить("truncated", Элементы.Количество() >= РабочийЛимит);
	Возврат Результат;

КонецФункции

// Структура объекта метаданных: реквизиты/измерения/ресурсы/ТЧ без колонок ТЧ, форм и движений.
// Найти вернул пусто → Неопределено (HTTP 404). Коллекция без Найти → исключение.
//
// Параметры:
//   ИмяКоллекции - Строка - идентификатор коллекции
//   ИмяОбъекта   - Строка - имя объекта в коллекции
//
// Возвращаемое значение:
//   Структура, Неопределено
//
Функция СтруктураОбъекта(ИмяКоллекции, ИмяОбъекта) Экспорт

	Попытка
		КоллекцияМетаданных = Метаданные[ИмяКоллекции];
	Исключение
		ВызватьИсключение "Unknown metadata type: " + ИмяКоллекции;
	КонецПопытки;

	Попытка
		ОбъектМетаданных = КоллекцияМетаданных.Найти(ИмяОбъекта);
	Исключение
		ВызватьИсключение "Metadata type does not support lookup: " + ИмяКоллекции;
	КонецПопытки;

	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("name", ОбъектМетаданных.Имя);
	Результат.Вставить("full_name", ОбъектМетаданных.ПолноеИмя());
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));

	ИменаКоллекций = Новый Массив;
	ИменаКоллекций.Добавить("СтандартныеРеквизиты");
	ИменаКоллекций.Добавить("Реквизиты");
	ИменаКоллекций.Добавить("Измерения");
	ИменаКоллекций.Добавить("Ресурсы");
	ИменаКоллекций.Добавить("ТабличныеЧасти");

	Для Каждого ИмяВложеннойКоллекции Из ИменаКоллекций Цикл
		Контейнер = Новый Структура;
		Контейнер.Вставить(ИмяВложеннойКоллекции);
		ЗаполнитьЗначенияСвойств(Контейнер, ОбъектМетаданных);
		КоллекцияРеквизитов = Контейнер[ИмяВложеннойКоллекции];
		Если КоллекцияРеквизитов = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элементы = Новый Массив;
		Для Каждого ЭлементКоллекции Из КоллекцияРеквизитов Цикл
			Описание = Новый Структура;
			Описание.Вставить("name", ЭлементКоллекции.Имя);
			Описание.Вставить("synonym", Строка(ЭлементКоллекции.Синоним));
			Если ИмяВложеннойКоллекции <> "ТабличныеЧасти" Тогда
				Описание.Вставить("type", Строка(ЭлементКоллекции.Тип));
			КонецЕсли;
			Элементы.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить(ИмяВложеннойКоллекции, Элементы);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализованныйЛимит(Лимит)

	ЛимитПоУмолчанию = 100;
	МаксимальныйЛимит = 1000;
	Если Лимит = Неопределено Или Лимит <= 0 Тогда
		Возврат ЛимитПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Лимит, МаксимальныйЛимит);

КонецФункции

#КонецОбласти
