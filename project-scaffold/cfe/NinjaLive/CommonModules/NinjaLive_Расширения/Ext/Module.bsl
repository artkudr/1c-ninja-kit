#Область ПрограммныйИнтерфейс

// Список расширений конфигурации. Отбор платформы не используется.
//
// Параметры:
//   МаскаИмени - Строка - подстрока имени или синонима; пусто - все
//
// Возвращаемое значение:
//   Структура - items, returned (без truncated/limit)
//
Функция Список(МаскаИмени) Экспорт

	Маска = ВРег(Строка(МаскаИмени));
	Элементы = Новый Массив;

	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Не ПустаяСтрока(Маска)
			И СтрНайти(ВРег(Расширение.Имя), Маска) = 0
			И СтрНайти(ВРег(Строка(Расширение.Синоним)), Маска) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Элементы.Добавить(ОписаниеРасширения(Расширение));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("items", Элементы);
	Результат.Вставить("returned", Элементы.Количество());
	Возврат Результат;

КонецФункции

// Версия установленного расширения с именем NinjaLive, не Метаданные.Версия основной КФ.
// Если расширение не найдено - пустая строка.
//
// Возвращаемое значение:
//   Строка
//
Функция ВерсияТекущего() Экспорт

	ИмяЭтогоРасширения = "NinjaLive";
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = ИмяЭтогоРасширения Тогда
			Возврат Расширение.Версия;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеРасширения(Расширение)

	Описание = Новый Структура;
	Описание.Вставить("name", Расширение.Имя);
	Описание.Вставить("synonym", Строка(Расширение.Синоним));
	Описание.Вставить("version", Расширение.Версия);
	Описание.Вставить("uuid", Строка(Расширение.УникальныйИдентификатор));
	Описание.Вставить("active", Расширение.Активно);
	Описание.Вставить("purpose", НазначениеJSON(Расширение.Назначение));
	Описание.Вставить("safe_mode", NinjaLive_JSON.ПривестиЗначениеКJSON(Расширение.БезопасныйРежим));
	Описание.Вставить("unsafe_action_protection", ЗащитаОтОпасныхДействийJSON(Расширение));
	Описание.Вставить("scope", Строка(Расширение.ОбластьДействия));
	Описание.Вставить("hash_sum", NinjaLive_JSON.ПривестиЗначениеКJSON(Расширение.ХешСумма));
	Описание.Вставить("master_node", ГлавныйУзелJSON(Расширение));
	Описание.Вставить("default_roles", ИменаОсновныхРолей(Расширение));
	Описание.Вставить("modifies_data_structure", Расширение.ИзменяетСтруктуруДанных());
	Описание.Вставить("use_default_roles_for_all_users", Расширение.ИспользоватьОсновныеРолиДляВсехПользователей);
	Описание.Вставить("used_in_distributed_infobase", Расширение.ИспользуетсяВРаспределеннойИнформационнойБазе);
	Возврат Описание;

КонецФункции

Функция НазначениеJSON(Назначение)

	Представление = ВРег(Строка(Назначение));
	Если Представление = "ДОПОЛНЕНИЕ" Или Представление = "ADDON" Тогда
		Возврат "AddOn";
	ИначеЕсли Представление = "ИСПРАВЛЕНИЕ" Или Представление = "PATCH" Тогда
		Возврат "Patch";
	ИначеЕсли Представление = "АДАПТАЦИЯ" Или Представление = "CUSTOMIZATION" Тогда
		Возврат "Customization";
	Иначе
		Возврат Строка(Назначение);
	КонецЕсли;

КонецФункции

Функция ЗащитаОтОпасныхДействийJSON(Расширение)

	Защита = Расширение.ЗащитаОтОпасныхДействий;
	Если Защита = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Защита.ПредупреждатьОбОпасныхДействиях;
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Возврат Строка(Защита);
	КонецПопытки;

КонецФункции

Функция ГлавныйУзелJSON(Расширение)

	Узел = Расширение.ГлавныйУзел;
	Если Не ЗначениеЗаполнено(Узел) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Узел);

КонецФункции

Функция ИменаОсновныхРолей(Расширение)

	ИменаРолей = Новый Массив;
	Для Каждого РольРасширения Из Расширение.ОсновныеРоли Цикл
		ИменаРолей.Добавить(РольРасширения.Имя);
	КонецЦикла;
	Возврат ИменаРолей;

КонецФункции

#КонецОбласти
