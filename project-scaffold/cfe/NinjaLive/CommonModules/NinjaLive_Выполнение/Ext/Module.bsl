#Область ПрограммныйИнтерфейс

// Проверяет синтаксис BSL без исполнения полезной нагрузки.
// Обёртка как в оригинале ninja: Если Ложь Тогда / код / КонецЕсли - не экранировать КонецЕсли.
// Риск: пользовательский КонецЕсли закрывает обёртку; хвост исполняется под основной ролью.
// Безопасный режим включается в этой функции; Выполнить - только во вложенной процедуре (AR-01).
//
// Параметры:
//   ТекстКода - Строка - фрагмент BSL
//
// Возвращаемое значение:
//   Структура - при успехе {valid}; при ошибке компиляции {valid, error}
//
Функция ПроверитьСинтаксис(ТекстКода) Экспорт

	// Не улучшать обёртку: множество valid должно совпадать с ninja.
	ТекстДляПроверки = "Если Ложь Тогда
	|" + ТекстКода + "
	|КонецЕсли;";

	Результат = Новый Структура;
	Попытка
		УстановитьБезопасныйРежим(Истина);
		ВыполнитьПроверкуСинтаксиса(ТекстДляПроверки);
		Результат.Вставить("valid", Истина);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		Результат.Вставить("valid", Ложь);
		Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Исполняет операторы BSL. Канал возврата - переменная Контекст (Структура).
// Safe mode не включается. HTTP-запрос в область Выполнить не попадает.
//
// Параметры:
//   ТекстКода - Строка - операторы BSL
//
// Возвращаемое значение:
//   Структура - success, duration_ms, context; при неуспехе ещё error
//
Функция ВыполнитьКод(ТекстКода) Экспорт

	Перем NinjaLive_Выполнение_Результат;
	Перем NinjaLive_Выполнение_Начало;

	Контекст = Новый Структура;
	NinjaLive_Выполнение_Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	NinjaLive_Выполнение_Результат = Новый Структура;

	Попытка
		ВыполнитьКодВИзоляции(ТекстКода, Контекст);
		NinjaLive_Выполнение_Результат.Вставить("success", Истина);
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		NinjaLive_Выполнение_Результат.Вставить("success", Ложь);
		NinjaLive_Выполнение_Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	NinjaLive_Выполнение_Результат.Вставить("duration_ms",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - NinjaLive_Выполнение_Начало);
	NinjaLive_Выполнение_Результат.Вставить("context", NinjaLive_JSON.ПривестиЗначениеКJSON(Контекст));
	Возврат NinjaLive_Выполнение_Результат;

КонецФункции

// Вычисляет выражение BSL. Safe mode не включается.
//
// Параметры:
//   ТекстВыражения - Строка - выражение
//
// Возвращаемое значение:
//   Структура - success; при успехе result и type; при неуспехе error
//
Функция ВычислитьВыражение(ТекстВыражения) Экспорт

	Перем NinjaLive_Выполнение_Результат;
	Перем NinjaLive_Выполнение_Значение;

	NinjaLive_Выполнение_Результат = Новый Структура;
	Попытка
		NinjaLive_Выполнение_Значение = ВычислитьВыражениеВИзоляции(ТекстВыражения);
		NinjaLive_Выполнение_Результат.Вставить("success", Истина);
		NinjaLive_Выполнение_Результат.Вставить("result",
			NinjaLive_JSON.ПривестиЗначениеКJSON(NinjaLive_Выполнение_Значение));
		NinjaLive_Выполнение_Результат.Вставить("type", Строка(ТипЗнч(NinjaLive_Выполнение_Значение)));
	Исключение // BSLLS:MissingCodeTryCatchEx-off
		NinjaLive_Выполнение_Результат.Вставить("success", Ложь);
		NinjaLive_Выполнение_Результат.Вставить("error", ОписаниеОшибки());
	КонецПопытки;

	Возврат NinjaLive_Выполнение_Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьПроверкуСинтаксиса(ТекстДляПроверки)

	// BSLLS:ExecuteExternalCodeInCommonModule-off
	Выполнить(ТекстДляПроверки); // BSLLS:ExecuteExternalCode-off

КонецПроцедуры

Процедура ВыполнитьКодВИзоляции(ТекстКода, Контекст)

	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Контекст = Новый Структура;
	КонецЕсли;
	// BSLLS:ExecuteExternalCodeInCommonModule-off
	Выполнить(ТекстКода); // BSLLS:ExecuteExternalCode-off

КонецПроцедуры

Функция ВычислитьВыражениеВИзоляции(ТекстВыражения)

	// BSLLS:ExecuteExternalCodeInCommonModule-off
	Возврат Вычислить(ТекстВыражения); // BSLLS:ExecuteExternalCode-off

КонецФункции

#КонецОбласти
