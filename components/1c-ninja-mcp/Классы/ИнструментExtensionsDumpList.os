// extensions_dump_list: список расширений ИБ через Designer (/DumpDBCfgList -AllExtensions).
// Как db-cfe-admin list, БЕЗ Enterprise/EPF. ibconnection — параметр / env / autumn-properties.
// TODO Phase2: опционально ibcmd для свойств (только file IB).

&ПараметрИнструмента(Имя = "ibconnection", Описание = "Строка подключения ИБ (/F или /S). Иначе env / autumn-properties", Тип = "string", Обязательный = Ложь)
Перем СтрокаПодключения;

&ПараметрИнструмента(Имя = "db-user", Описание = "Пользователь ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПользовательИБ;

&ПараметрИнструмента(Имя = "db-pwd", Описание = "Пароль ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПарольИБ;

&ПараметрИнструмента(Имя = "properties", Описание = "Путь к autumn-properties.json (поиск ibconnection)", Тип = "string", Обязательный = Ложь)
Перем ПутьProperties;

&ПараметрИнструмента(Имя = "name", Описание = "Фильтр по имени расширения (без фильтра — все)", Тип = "string", Обязательный = Ложь)
Перем ИмяРасширения;

&Инструмент(Имя = "extensions_dump_list", Описание = "Список расширений конфигурации в ИБ через Designer (/DumpDBCfgList -AllExtensions), как db-cfe-admin list. Без Enterprise/EPF. ibconnection — параметр, env или autumn-properties.json. Версия 1cv8: V8PATH / v8version (env V8VERSION/VRUNNER_V8VERSION или properties), иначе новейшая установленная. Имя extensions_dump_list — чтобы не путать с vrunner extensions_list.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьExtensionsDumpList() Экспорт

	Подключение = РазрешитьСтрокуПодключения();
	Если ПустаяСтрока(Подключение) Тогда
		ВызватьИсключение "extensions_dump_list: обязателен ibconnection — параметр, env IBCONNECTION/VRUNNER_IBCONNECTION, или autumn-properties.json (vrunner.ibconnection).";
	КонецЕсли;

	Пользователь = РазрешитьПользователя();
	Пароль = РазрешитьПароль();

	ВерсияПлатформы = РазрешитьВерсиюПлатформы();
	Путь1cv8 = Найти1cv8(ВерсияПлатформы);
	Если ПустаяСтрока(Путь1cv8) Тогда
		Доп = "";
		Если Не ПустаяСтрока(ВерсияПлатформы) Тогда
			Доп = " под v8version=" + ВерсияПлатформы;
		КонецЕсли;
		ВызватьИсключение "extensions_dump_list: не найден 1cv8.exe" + Доп
			+ " (задайте V8PATH / VRUNNER_V8PATH / v8version или установите платформу)";
	КонецЕсли;

	Разбор = РазобратьIbconnection(Подключение);
	Если ПустаяСтрока(Разбор.Тип) Тогда
		ВызватьИсключение "extensions_dump_list: не удалось разобрать ibconnection (ожидается /F... или /S...)";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	КаталогВрем = ФС.ОбъединитьПути(КаталогВременныхФайлов(), "ext_dump_list_" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(КаталогВрем);
	ФайлЛогаПлатформы = ФС.ОбъединитьПути(КаталогВрем, "out.txt");

	Попытка
		Части = Новый Массив;
		Части.Добавить(Кавычки(Путь1cv8));
		Части.Добавить("DESIGNER");

		Если Разбор.Тип = "F" Тогда
			Части.Добавить("/F" + Кавычки(Разбор.Значение));
		Иначе
			// Как db-cfe-admin: /S "server/ref" (слэш), не /S"server\ref"
			ЗначениеS = СтрЗаменить(Разбор.Значение, "\", "/");
			Части.Добавить("/S");
			Части.Добавить(Кавычки(ЗначениеS));
		КонецЕсли;

		Если Не ПустаяСтрока(Пользователь) Тогда
			Части.Добавить("/N" + Кавычки(Пользователь));
		КонецЕсли;
		Если Не ПустаяСтрока(Пароль) Тогда
			Части.Добавить("/P" + Кавычки(Пароль));
		КонецЕсли;

		Части.Добавить("/DumpDBCfgList");
		Части.Добавить("-AllExtensions");
		Части.Добавить("/Out");
		Части.Добавить(Кавычки(ФайлЛогаПлатформы));
		Части.Добавить("/DisableStartupDialogs");

		ЗапуститьDesigner(СтрСоединить(Части, " "), ФайлЛогаПлатформы, ФС, Путь1cv8);

		ТекстСписка = "";
		Если ФС.ФайлСуществует(ФайлЛогаПлатформы) Тогда
			ТекстСписка = ФС.ПрочитатьФайлКакТекст(ФайлЛогаПлатформы);
		КонецЕсли;

		Имена = РазобратьИменаИзЛога(ТекстСписка);
		Если Не ПустаяСтрока(ИмяРасширения) Тогда
			Имена = ОтфильтроватьПоИмени(Имена, СокрЛП(ИмяРасширения));
			Если Имена.Количество() = 0 Тогда
				УдалитьКаталогВрем(КаталогВрем);
				ВызватьИсключение "extensions_dump_list: расширение '" + СокрЛП(ИмяРасширения) + "' в базе не найдено";
			КонецЕсли;
		КонецЕсли;

		УдалитьКаталогВрем(КаталогВрем);
		Возврат СформироватьОтчёт(Имена, Подключение);

	Исключение
		УдалитьКаталогВрем(КаталогВрем);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Процедура ЗапуститьDesigner(СтрокаКоманды, ФайлЛогаПлатформы, ФС, Путь1cv8 = "")

	ФайлЛогаCmd = ПолучитьИмяВременногоФайла("txt");
	// Двойные кавычки вокруг всей команды — иначе cmd /c съедает аргументы у пути с пробелами (Program Files).
	КомандаСЛогом = "cmd /c " + Кавычки(СтрокаКоманды + " > " + Кавычки(ФайлЛогаCmd) + " 2>&1");

	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		ВызватьИсключение "extensions_dump_list: не удалось запустить 1cv8 DESIGNER: " + ОписаниеОшибки();
	КонецПопытки;

	ТекстCmd = "";
	Попытка
		Если ФС.ФайлСуществует(ФайлЛогаCmd) Тогда
			ТекстCmd = ФС.ПрочитатьФайлКакТекст(ФайлЛогаCmd);
		КонецЕсли;
	Исключение
		ТекстCmd = "";
	КонецПопытки;

	Попытка
		УдалитьФайлы(ФайлЛогаCmd);
	Исключение
		// ignore
	КонецПопытки;

	Если КодВозврата <> 0 Тогда
		ТекстПлатформы = "";
		Если ФС.ФайлСуществует(ФайлЛогаПлатформы) Тогда
			Попытка
				ТекстПлатформы = ФС.ПрочитатьФайлКакТекст(ФайлЛогаПлатформы);
			Исключение
				ТекстПлатформы = "";
			КонецПопытки;
		КонецЕсли;
		ВызватьИсключение "extensions_dump_list: DESIGNER /DumpDBCfgList завершился с кодом "
			+ Строка(КодВозврата)
			+ ?(ПустаяСтрока(Путь1cv8), "", Символы.ПС + "1cv8=" + Путь1cv8)
			+ Символы.ПС + ТекстCmd + Символы.ПС + ТекстПлатформы;
	КонецЕсли;

КонецПроцедуры

Функция РазобратьИменаИзЛога(Текст)

	Имена = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Имена;
	КонецЕсли;

	Для Каждого СтрокаЛога Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Имя = СокрЛП(СтрЗаменить(СтрокаЛога, Символы.ВК, ""));
		Если Не ПустаяСтрока(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

Функция ОтфильтроватьПоИмени(Имена, НужноеИмя)

	Результат = Новый Массив;
	НужноеВРег = ВРег(НужноеИмя);
	Для Каждого Имя Из Имена Цикл
		Если ВРег(Имя) = НужноеВРег Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СформироватьОтчёт(Имена, Подключение)

	Строки = Новый Массив;
	Строки.Добавить("[РАСШИРЕНИЯ] " + СокрЛП(Подключение) + "   (" + Строка(Имена.Количество()) + ")");
	Если Имена.Количество() = 0 Тогда
		Строки.Добавить("  расширений нет");
	Иначе
		Для Каждого Имя Из Имена Цикл
			Строки.Добавить("  " + Имя);
		КонецЦикла;
		Строки.Добавить("  свойства недоступны: phase2 (ibcmd, только file IB)");
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция РазобратьIbconnection(Подключение)

	Результат = Новый Структура("Тип, Значение", "", "");
	Стр = СокрЛП(Подключение);
	Если СтрДлина(Стр) < 2 Тогда
		Возврат Результат;
	КонецЕсли;

	Префикс = ВРег(Лев(Стр, 2));
	Если Префикс <> "/F" И Префикс <> "/S" Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Тип = Сред(Префикс, 2, 1);
	Хвост = СокрЛП(Сред(Стр, 3));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		Поз = СтрНайти(Хвост, """");
		Если Поз > 0 Тогда
			Хвост = Лев(Хвост, Поз - 1);
		КонецЕсли;
	Иначе
		ПозПробел = СтрНайти(Хвост, " /");
		Если ПозПробел > 0 Тогда
			Хвост = СокрЛП(Лев(Хвост, ПозПробел - 1));
		КонецЕсли;
	КонецЕсли;

	Результат.Значение = СокрЛП(Хвост);
	Если ПустаяСтрока(Результат.Значение) Тогда
		Результат.Тип = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция РазрешитьВерсиюПлатформы()

	ИзEnv = ПолучитьПеременнуюСреды("V8VERSION");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_V8VERSION");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("v8version");

КонецФункции

Функция ВерсияПодходитПодФильтр(ИмяВерсии, Фильтр)

	Если ПустаяСтрока(Фильтр) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Не СтрНачинаетсяС(ИмяВерсии, Фильтр) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрДлина(ИмяВерсии) = СтрДлина(Фильтр) Тогда
		Возврат Истина;
	КонецЕсли;
	// "8.3" → "8.3.27.2130", но не "8.30..."
	Возврат Сред(ИмяВерсии, СтрДлина(Фильтр) + 1, 1) = ".";

КонецФункции

Функция СравнитьВерсииПлатформы(Версия1, Версия2)

	Части1 = СтрРазделить(Версия1, ".", Ложь);
	Части2 = СтрРазделить(Версия2, ".", Ложь);
	МаксИндекс = Макс(Части1.Количество(), Части2.Количество()) - 1;
	Для Индекс = 0 По МаксИндекс Цикл
		Н1 = 0;
		Н2 = 0;
		Если Индекс < Части1.Количество() Тогда
			Попытка
				Н1 = Число(Части1[Индекс]);
			Исключение
				Н1 = 0;
			КонецПопытки;
		КонецЕсли;
		Если Индекс < Части2.Количество() Тогда
			Попытка
				Н2 = Число(Части2[Индекс]);
			Исключение
				Н2 = 0;
			КонецПопытки;
		КонецЕсли;
		Если Н1 > Н2 Тогда
			Возврат 1;
		ИначеЕсли Н1 < Н2 Тогда
			Возврат -1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

Функция Найти1cv8(ФильтрВерсии = "")

	Кандидаты = Новый Массив;
	ИзEnv = ПолучитьПеременнуюСреды("V8PATH");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_V8PATH");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Кандидаты.Добавить(СокрЛП(ИзEnv));
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Для Каждого Кандидат Из Кандидаты Цикл
		Путь = Кандидат;
		Если ФС.КаталогСуществует(Путь) Тогда
			Путь = ФС.ОбъединитьПути(Путь, "1cv8.exe");
		КонецЕсли;
		Если ФС.ФайлСуществует(Путь) Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЦикла;

	Корни = Новый Массив;
	Корни.Добавить("C:\Program Files\1cv8");
	Корни.Добавить("C:\Program Files (x86)\1cv8");
	Лучший = "";
	ЛучшаяВерсия = "";
	Для Каждого Корень Из Корни Цикл
		Если Не ФС.КаталогСуществует(Корень) Тогда
			Продолжить;
		КонецЕсли;
		Найденные = НайтиФайлы(Корень, "1cv8.exe", Истина);
		Для Каждого Файл Из Найденные Цикл
			Если ВРег(Файл.Имя) <> "1CV8.EXE" Тогда
				Продолжить;
			КонецЕсли;
			// ...\8.3.x\bin\1cv8.exe → имя каталога версии
			ФайлBin = Новый Файл(Файл.Путь);
			ФайлВерсии = Новый Файл(ФайлBin.Путь);
			ИмяВерсии = ФайлВерсии.Имя;
			Если Не ВерсияПодходитПодФильтр(ИмяВерсии, ФильтрВерсии) Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(ЛучшаяВерсия) Или СравнитьВерсииПлатформы(ИмяВерсии, ЛучшаяВерсия) > 0 Тогда
				ЛучшаяВерсия = ИмяВерсии;
				Лучший = Файл.ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

Процедура УдалитьКаталогВрем(Путь)

	Попытка
		УдалитьФайлы(Путь);
	Исключение
		// ignore
	КонецПопытки;

КонецПроцедуры

Функция РазрешитьСтрокуПодключения()

	Если Не ПустаяСтрока(СтрокаПодключения) Тогда
		Возврат СокрЛП(СтрокаПодключения);
	КонецЕсли;

	ИзEnv = ПолучитьПеременнуюСреды("IBCONNECTION");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_IBCONNECTION");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;

	Возврат ПрочитатьИзProperties("ibconnection");

КонецФункции

Функция РазрешитьПользователя()

	Если Не ПустаяСтрока(ПользовательИБ) Тогда
		Возврат СокрЛП(ПользовательИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBUSER");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBUSER");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-user");

КонецФункции

Функция РазрешитьПароль()

	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Возврат СокрЛП(ПарольИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBPWD");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBPWD");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-pwd");

КонецФункции

Функция ПрочитатьИзProperties(ИмяКлюча)

	Путь = ПутьКProperties();
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.ФайлСуществует(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ФС.ПрочитатьФайлКакТекст(Путь);
	Маркер = """" + ИмяКлюча + """";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + СтрДлина(Маркер));
	ПозДвоеточия = СтрНайти(Хвост, ":");
	Если ПозДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(Хвост, ПозДвоеточия + 1));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		ПозКонца = СтрНайти(Хвост, """");
		Если ПозКонца = 0 Тогда
			Возврат "";
		КонецЕсли;
		// Сырой JSON: "/Sserver\\base" → один обратный слэш
		Возврат СтрЗаменить(Сред(Хвост, 1, ПозКонца - 1), "\\", "\");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПутьКProperties()

	Если Не ПустаяСтрока(ПутьProperties) Тогда
		Возврат СокрЛП(ПутьProperties);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("AUTUMN_PROPERTIES");
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	ФС = Новый СервисФайловойСистемы();
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("autumn-properties.json");
	Кандидаты.Добавить(ФС.ОбъединитьПути(ТекущийКаталог(), "autumn-properties.json"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ФС.ФайлСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Кавычки(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции
