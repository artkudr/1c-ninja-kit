// config_list: дерево каталогов/файлов выгрузки с отступами.

&ПараметрИнструмента(Имя = "path", Описание = "Корень выгрузки (каталог конфигурации)", Тип = "string", Обязательный = Истина)
Перем Путь;

&ПараметрИнструмента(Имя = "maxDepth", Описание = "Максимальная глубина обхода (по умолчанию 2, обычно достаточно 1–3)", Тип = "integer", Обязательный = Ложь)
Перем МаксГлубина;

&Инструмент(Имя = "config_list", Описание = "Список объектов конфигурации: каталоги и файлы (модули) от указанного каталога, с отступами (два пробела на уровень).")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьConfigList() Экспорт

	Если ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Argument 'path' is required";
	КонецЕсли;
	Если МаксГлубина = Неопределено Тогда
		МаксГлубина = 2;
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.КаталогСуществует(Путь) Тогда
		ВызватьИсключение "Directory not found: " + Путь;
	КонецЕсли;

	Строки = Новый Массив;
	ДобавитьСтрокиДерева(Путь, "", 0, МаксГлубина, Строки);
	Возврат СтрСоединить(Строки, Символ(10));

КонецФункции

Процедура ДобавитьСтрокиДерева(Корень, ОтносительныйПуть, Уровень, МаксГлубина, Строки)
	ФС = Новый СервисФайловойСистемы();
	Каталог = Новый Файл(ФС.ОбъединитьПути(Корень, ОтносительныйПуть));
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда Возврат; КонецЕсли;
	Найденные = НайтиФайлы(Каталог.ПолноеИмя, "*", Ложь);
	Для Каждого Найденный Из Найденные Цикл
		ОтнПуть = ?(ПустаяСтрока(ОтносительныйПуть), Найденный.Имя, ОтносительныйПуть + "/" + Найденный.Имя);
		Отступ = ПовторитьСтроку("  ", Уровень);
		Строки.Добавить(Отступ + ОтнПуть);
		Если Найденный.ЭтоКаталог() И Уровень < МаксГлубина Тогда
			ДобавитьСтрокиДерева(Корень, ОтнПуть, Уровень + 1, МаксГлубина, Строки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПовторитьСтроку(Стр, Раз)
	Результат = "";
	Для Инд = 1 По Раз Цикл
		Результат = Результат + Стр;
	КонецЦикла;
	Возврат Результат;
КонецФункции