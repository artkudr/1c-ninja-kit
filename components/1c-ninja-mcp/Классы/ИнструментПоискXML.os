// xml_search: поиск по XML метаданных. Результат: путь:номер:фрагмент.

&ПараметрИнструмента(Имя = "path", Описание = "Корень выгрузки (каталог с XML-файлами метаданных)", Тип = "string", Обязательный = Истина)
Перем Путь;

&ПараметрИнструмента(Имя = "query", Описание = "Строка для поиска", Тип = "string", Обязательный = Истина)
Перем Запрос;

&Инструмент(Имя = "xml_search", Описание = "Поиск текста по XML-файлам метаданных в каталоге выгрузки конфигурации. Формат результата: путь:номер:фрагмент. UTF-8.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьПоискXML() Экспорт

	Если ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Argument 'path' is required";
	КонецЕсли;
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Argument 'query' is required";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.КаталогСуществует(Путь) Тогда
		ВызватьИсключение "Directory not found: " + Путь;
	КонецЕсли;

	ФайлыXml = НайтиФайлы(Путь, "*.xml", Истина);
	Результат = Новый Массив;
	Для Каждого ФайлИнфо Из ФайлыXml Цикл
		Если ФайлИнфо.ЭтоКаталог() Тогда Продолжить; КонецЕсли;
		ПолныйПуть = ФайлИнфо.ПолноеИмя;
		ТекстФайла = ФС.ПрочитатьФайлКакТекст(ПолныйПуть);
		Строки = СтрРазделить(ТекстФайла, Символ(10), Ложь);
		НомерСтроки = 0;
		Для Каждого СтрокаТекста Из Строки Цикл
			НомерСтроки = НомерСтроки + 1;
			Если СтрНайти(СтрокаТекста, Запрос) > 0 Тогда
				Результат.Добавить(ПолныйПуть + ":" + Формат(НомерСтроки, "ЧГ=0") + ":" + СтрокаТекста);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символ(10));

КонецФункции