// cf_dump_xml: выгрузка конфигурации ИБ в XML (DumpConfigToFiles).
// Режимы Full/Changes/Partial/UpdateInfo по скиллу db-dump-xml.
// Без .v8-project.json: ibconnection из параметра / env / autumn-properties (как epf_decompile).
// Full без extension — vrunner cf decompile; иначе Designer 1cv8 (Changes/Partial/UpdateInfo, extension).

&ПараметрИнструмента(Имя = "out", Описание = "Каталог выгрузки XML-исходников", Тип = "string", Обязательный = Истина)
Перем КаталогВывода;

&ПараметрИнструмента(Имя = "mode", Описание = "Режим: Full / Changes (по умолч.) / Partial / UpdateInfo", Тип = "string", Обязательный = Ложь)
Перем Режим;

&ПараметрИнструмента(Имя = "objects", Описание = "Объекты через запятую (обязательно для Partial)", Тип = "string", Обязательный = Ложь)
Перем Объекты;

&ПараметрИнструмента(Имя = "extension", Описание = "Имя расширения для выгрузки", Тип = "string", Обязательный = Ложь)
Перем Расширение;

&ПараметрИнструмента(Имя = "ibconnection", Описание = "Строка подключения ИБ (/F или /S). Иначе env / autumn-properties", Тип = "string", Обязательный = Ложь)
Перем СтрокаПодключения;

&ПараметрИнструмента(Имя = "db-user", Описание = "Пользователь ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПользовательИБ;

&ПараметрИнструмента(Имя = "db-pwd", Описание = "Пароль ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПарольИБ;

&ПараметрИнструмента(Имя = "properties", Описание = "Путь к autumn-properties.json (поиск ibconnection)", Тип = "string", Обязательный = Ложь)
Перем ПутьProperties;

&Инструмент(Имя = "cf_dump_xml", Описание = "Выгрузить конфигурацию ИБ в XML (DumpConfigToFiles). Режимы Full/Changes/Partial/UpdateInfo. Без ibconnection (параметр, env IBCONNECTION/VRUNNER_IBCONNECTION или autumn-properties.json) — отказ. Full без extension — через vrunner cf decompile; иначе Designer 1cv8.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьCfDumpXml() Экспорт

	Если ПустаяСтрока(КаталогВывода) Тогда
		ВызватьИсключение "Argument 'out' is required";
	КонецЕсли;

	Подключение = РазрешитьСтрокуПодключения();
	Если ПустаяСтрока(Подключение) Тогда
		ВызватьИсключение "cf_dump_xml: обязателен ibconnection — параметр, env IBCONNECTION/VRUNNER_IBCONNECTION, или autumn-properties.json (vrunner.ibconnection). Без ИБ выгрузка запрещена.";
	КонецЕсли;

	Пользователь = РазрешитьПользователя();
	Пароль = РазрешитьПароль();
	РежимНорм = НормализоватьРежим();

	Если РежимНорм = "Partial" И ПустаяСтрока(Объекты) Тогда
		ВызватьИсключение "cf_dump_xml: для mode=Partial обязателен параметр objects (имена через запятую)";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	ОбеспечитьКаталогВывода(ФС, КаталогВывода);

	// Full без расширения — vrunner умеет; остальные режимы и extension — прямой Designer.
	Если РежимНорм = "Full" И ПустаяСтрока(Расширение) Тогда
		Возврат ВыгрузитьЧерезVrunner(Подключение, Пользователь, Пароль);
	КонецЕсли;

	Возврат ВыгрузитьЧерезDesigner(Подключение, Пользователь, Пароль, РежимНорм, ФС);

КонецФункции

Функция НормализоватьРежим()

	Р = ВРег(СокрЛП(Режим));
	Если ПустаяСтрока(Р) Тогда
		Если Не ПустаяСтрока(Объекты) Тогда
			Возврат "Partial";
		КонецЕсли;
		Возврат "Changes";
	КонецЕсли;

	Если Р = "FULL" Тогда
		Если Не ПустаяСтрока(Объекты) Тогда
			Возврат "Partial";
		КонецЕсли;
		Возврат "Full";
	ИначеЕсли Р = "CHANGES" Тогда
		Если Не ПустаяСтрока(Объекты) Тогда
			Возврат "Partial";
		КонецЕсли;
		Возврат "Changes";
	ИначеЕсли Р = "PARTIAL" Тогда
		Возврат "Partial";
	ИначеЕсли Р = "UPDATEINFO" Тогда
		Если Не ПустаяСтрока(Объекты) Тогда
			ВызватьИсключение "cf_dump_xml: mode=UpdateInfo не принимает objects";
		КонецЕсли;
		Возврат "UpdateInfo";
	КонецЕсли;

	ВызватьИсключение "cf_dump_xml: неизвестный mode='" + Режим + "' (ожидается Full/Changes/Partial/UpdateInfo)";

КонецФункции

Функция ВыгрузитьЧерезVrunner(Подключение, Пользователь, Пароль)

	Части = Новый Массив;
	Части.Добавить("vrunner");
	Части.Добавить("cf");
	Части.Добавить("decompile");
	Части.Добавить("--ibconnection");
	Части.Добавить(Кавычки(Подключение));
	Если Не ПустаяСтрока(Пользователь) Тогда
		Части.Добавить("--db-user");
		Части.Добавить(Кавычки(Пользователь));
	КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда
		Части.Добавить("--db-pwd");
		Части.Добавить(Кавычки(Пароль));
	КонецЕсли;
	Части.Добавить("--src-format");
	Части.Добавить("xml");
	Части.Добавить(Кавычки(КаталогВывода));

	Возврат ЗапуститьИСобратьЛог(СтрСоединить(Части, " "), "vrunner cf decompile");

КонецФункции

Функция ВыгрузитьЧерезDesigner(Подключение, Пользователь, Пароль, РежимНорм, ФС)

	Путь1cv8 = Найти1cv8();
	Если ПустаяСтрока(Путь1cv8) Тогда
		ВызватьИсключение "cf_dump_xml: не найден 1cv8.exe (задайте V8PATH / VRUNNER_V8PATH или установите платформу)";
	КонецЕсли;

	Разбор = РазобратьIbconnection(Подключение);
	Если ПустаяСтрока(Разбор.Тип) Тогда
		ВызватьИсключение "cf_dump_xml: не удалось разобрать ibconnection (ожидается /F... или /S...)";
	КонецЕсли;

	КаталогВрем = ФС.ОбъединитьПути(КаталогВременныхФайлов(), "cf_dump_xml_" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(КаталогВрем);

	ФайлСписка = "";
	ФайлЛогаПлатформы = ФС.ОбъединитьПути(КаталогВрем, "dump_log.txt");

	Текст = "";
	Попытка
		Части = Новый Массив;
		Части.Добавить(Кавычки(Путь1cv8));
		Части.Добавить("DESIGNER");

		Если Разбор.Тип = "F" Тогда
			Части.Добавить("/F" + Кавычки(Разбор.Значение));
		Иначе
			Части.Добавить("/S" + Кавычки(Разбор.Значение));
		КонецЕсли;

		Если Не ПустаяСтрока(Пользователь) Тогда
			Части.Добавить("/N" + Кавычки(Пользователь));
		КонецЕсли;
		Если Не ПустаяСтрока(Пароль) Тогда
			Части.Добавить("/P" + Кавычки(Пароль));
		КонецЕсли;

		Части.Добавить("/DumpConfigToFiles");
		Части.Добавить(Кавычки(КаталогВывода));
		Части.Добавить("-Format");
		Части.Добавить("Hierarchical");

		Если РежимНорм = "Changes" Тогда
			Части.Добавить("-update");
			Части.Добавить("-force");
		ИначеЕсли РежимНорм = "Partial" Тогда
			ФайлСписка = ФС.ОбъединитьПути(КаталогВрем, "dump_list.txt");
			ЗаписатьСписокОбъектов(ФайлСписка, Объекты);
			Части.Добавить("-listFile");
			Части.Добавить(Кавычки(ФайлСписка));
		ИначеЕсли РежимНорм = "UpdateInfo" Тогда
			Части.Добавить("-configDumpInfoOnly");
		КонецЕсли;
		// Full — без доп. ключей

		Если Не ПустаяСтрока(Расширение) Тогда
			Части.Добавить("-Extension");
			Части.Добавить(Кавычки(Расширение));
		КонецЕсли;

		Части.Добавить("/Out");
		Части.Добавить(Кавычки(ФайлЛогаПлатформы));
		Части.Добавить("/DisableStartupDialogs");

		Текст = ЗапуститьИСобратьЛог(СтрСоединить(Части, " "), "1cv8 DESIGNER /DumpConfigToFiles");

		Если ФС.ФайлСуществует(ФайлЛогаПлатформы) Тогда
			ЛогПлатформы = ФС.ПрочитатьФайлКакТекст(ФайлЛогаПлатформы);
			Если Не ПустаяСтрока(ЛогПлатформы) Тогда
				Текст = Текст + Символы.ПС + "--- Designer /Out ---" + Символы.ПС + ЛогПлатформы;
			КонецЕсли;
		КонецЕсли;

	Исключение
		УдалитьКаталогВрем(КаталогВрем);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьКаталогВрем(КаталогВрем);
	Возврат Текст;

КонецФункции

Процедура ЗаписатьСписокОбъектов(ПутьФайла, СписокЧерезЗапятую)

	Строки = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СписокЧерезЗапятую, ",", Ложь) Цикл
		Имя = СокрЛП(Часть);
		Если Не ПустаяСтрока(Имя) Тогда
			Строки.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		ВызватьИсключение "cf_dump_xml: objects пуст после разбора";
	КонецЕсли;

	// UTF-8 BOM — как в db-dump-xml.ps1 (платформа ожидает BOM для listFile)
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8, Символы.ПС, Ложь, Символы.ПС);
	Для Каждого Стр Из Строки Цикл
		Запись.ЗаписатьСтроку(Стр);
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

Функция ЗапуститьИСобратьЛог(СтрокаКоманды, Метка)

	ФайлЛога = ПолучитьИмяВременногоФайла("txt");
	КомандаСЛогом = "cmd /c " + СтрокаКоманды + " > " + Кавычки(ФайлЛога) + " 2>&1";

	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		ВызватьИсключение "cf_dump_xml: не удалось запустить " + Метка + ": " + ОписаниеОшибки();
	КонецПопытки;

	ТекстЛога = "";
	ФС = Новый СервисФайловойСистемы();
	Попытка
		Если ФС.ФайлСуществует(ФайлЛога) Тогда
			ТекстЛога = ФС.ПрочитатьФайлКакТекст(ФайлЛога);
		КонецЕсли;
	Исключение
		ТекстЛога = "(лог недоступен: " + ОписаниеОшибки() + ")";
	КонецПопытки;

	Попытка
		УдалитьФайлы(ФайлЛога);
	Исключение
		// ignore
	КонецПопытки;

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "cf_dump_xml: " + Метка + " завершился с кодом " + Строка(КодВозврата) + Символы.ПС + ТекстЛога;
	КонецЕсли;

	Если ПустаяСтрока(ТекстЛога) Тогда
		Возврат "OK: " + Метка + " завершён (код 0), out=" + КаталогВывода;
	КонецЕсли;
	Возврат ТекстЛога;

КонецФункции

Функция РазобратьIbconnection(Подключение)

	Результат = Новый Структура("Тип, Значение", "", "");
	Стр = СокрЛП(Подключение);
	Если СтрДлина(Стр) < 2 Тогда
		Возврат Результат;
	КонецЕсли;

	Префикс = ВРег(Лев(Стр, 2));
	Если Префикс <> "/F" И Префикс <> "/S" Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Тип = Сред(Префикс, 2, 1); // F или S
	Хвост = СокрЛП(Сред(Стр, 3));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		Поз = СтрНайти(Хвост, """");
		Если Поз > 0 Тогда
			Хвост = Лев(Хвост, Поз - 1);
		КонецЕсли;
	Иначе
		// обрезать хвостовые /N /P если склеены в одной строке редко; обычно ibconnection чистый
		ПозПробел = СтрНайти(Хвост, " /");
		Если ПозПробел > 0 Тогда
			Хвост = СокрЛП(Лев(Хвост, ПозПробел - 1));
		КонецЕсли;
	КонецЕсли;

	Результат.Значение = СокрЛП(Хвост);
	Если ПустаяСтрока(Результат.Значение) Тогда
		Результат.Тип = "";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Найти1cv8()

	Кандидаты = Новый Массив;
	ИзEnv = ПолучитьПеременнуюСреды("V8PATH");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_V8PATH");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Кандидаты.Добавить(СокрЛП(ИзEnv));
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Для Каждого Кандидат Из Кандидаты Цикл
		Путь = Кандидат;
		Если ФС.КаталогСуществует(Путь) Тогда
			Путь = ФС.ОбъединитьПути(Путь, "1cv8.exe");
		КонецЕсли;
		Если ФС.ФайлСуществует(Путь) Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЦикла;

	// Последняя версия из Program Files: ...\8.x.y.z\bin\1cv8.exe
	Корни = Новый Массив;
	Корни.Добавить("C:\Program Files\1cv8");
	Корни.Добавить("C:\Program Files (x86)\1cv8");
	Лучший = "";
	ЛучшаяВерсия = "";
	Для Каждого Корень Из Корни Цикл
		Если Не ФС.КаталогСуществует(Корень) Тогда
			Продолжить;
		КонецЕсли;
		Найденные = НайтиФайлы(Корень, "1cv8.exe", Истина);
		Для Каждого Файл Из Найденные Цикл
			Если ВРег(Файл.Имя) <> "1CV8.EXE" Тогда
				Продолжить;
			КонецЕсли;
			КатBin = Новый Файл(Файл.Путь);
			КатВерсии = Новый Файл(КатBin.Путь);
			ИмяВерсии = КатВерсии.Имя;
			Если ИмяВерсии > ЛучшаяВерсия Тогда
				ЛучшаяВерсия = ИмяВерсии;
				Лучший = Файл.ПолноеИмя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Лучший;

КонецФункции

Процедура ОбеспечитьКаталогВывода(ФС, Путь)

	Если ФС.КаталогСуществует(Путь) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СоздатьКаталог(Путь);
	Исключение
		ВызватьИсключение "cf_dump_xml: не удалось создать каталог out=" + Путь + ": " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

Процедура УдалитьКаталогВрем(Путь)

	Попытка
		УдалитьФайлы(Путь);
	Исключение
		// ignore
	КонецПопытки;

КонецПроцедуры

Функция РазрешитьСтрокуПодключения()

	Если Не ПустаяСтрока(СтрокаПодключения) Тогда
		Возврат СокрЛП(СтрокаПодключения);
	КонецЕсли;

	ИзEnv = ПолучитьПеременнуюСреды("IBCONNECTION");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_IBCONNECTION");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;

	Возврат ПрочитатьИзProperties("ibconnection");

КонецФункции

Функция РазрешитьПользователя()

	Если Не ПустаяСтрока(ПользовательИБ) Тогда
		Возврат СокрЛП(ПользовательИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBUSER");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBUSER");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-user");

КонецФункции

Функция РазрешитьПароль()

	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Возврат СокрЛП(ПарольИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBPWD");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBPWD");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-pwd");

КонецФункции

Функция ПрочитатьИзProperties(ИмяКлюча)

	Путь = ПутьКProperties();
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.ФайлСуществует(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ФС.ПрочитатьФайлКакТекст(Путь);
	Маркер = """" + ИмяКлюча + """";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + СтрДлина(Маркер));
	ПозДвоеточия = СтрНайти(Хвост, ":");
	Если ПозДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(Хвост, ПозДвоеточия + 1));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		ПозКонца = СтрНайти(Хвост, """");
		Если ПозКонца = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат Сред(Хвост, 1, ПозКонца - 1);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПутьКProperties()

	Если Не ПустаяСтрока(ПутьProperties) Тогда
		Возврат СокрЛП(ПутьProperties);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("AUTUMN_PROPERTIES");
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	ФС = Новый СервисФайловойСистемы();
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("autumn-properties.json");
	Кандидаты.Добавить(ФС.ОбъединитьПути(ТекущийКаталог(), "autumn-properties.json"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ФС.ФайлСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Кавычки(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции
