// live_event_log: журнал регистрации живой ИБ (POST /event-log).

&ПараметрИнструмента(Имя = "date_from", Описание = "Начало периода (ISO-дата/дата-время)", Тип = "string", Обязательный = Ложь)
Перем ДатаС;

&ПараметрИнструмента(Имя = "date_to", Описание = "Конец периода (ISO-дата/дата-время)", Тип = "string", Обязательный = Ложь)
Перем ДатаПо;

&ПараметрИнструмента(Имя = "level", Описание = "Уровень: Информация / Предупреждение / Ошибка / Примечание", Тип = "string", Обязательный = Ложь)
Перем Уровень;

&ПараметрИнструмента(Имя = "user", Описание = "Фильтр по имени пользователя ИБ (не путать с user авторизации HTTP)", Тип = "string", Обязательный = Ложь)
Перем ПользовательЖурнала;

&ПараметрИнструмента(Имя = "event", Описание = "Имя события журнала", Тип = "string", Обязательный = Ложь)
Перем Событие;

&ПараметрИнструмента(Имя = "metadata", Описание = "Полное имя объекта метаданных", Тип = "string", Обязательный = Ложь)
Перем МетаданныеФильтр;

&ПараметрИнструмента(Имя = "contains", Описание = "Подстрока в комментарии/данных (пост-фильтр)", Тип = "string", Обязательный = Ложь)
Перем Подстрока;

&ПараметрИнструмента(Имя = "limit", Описание = "Максимум записей (по умолчанию 100, макс 1000)", Тип = "integer", Обязательный = Ложь)
Перем Лимит;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "auth_user", Описание = "Пользователь HTTP Basic (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем ПользовательAuth;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль HTTP Basic (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_event_log", Описание = "Журнал регистрации живой ИБ через NinjaLive (POST /event-log). JSON: columns, rows, total, truncated.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveEventLog() Экспорт

	Тело = Новый Структура;
	Если Не ПустаяСтрока(ДатаС) Тогда
		Тело.Вставить("date_from", ДатаС);
	КонецЕсли;
	Если Не ПустаяСтрока(ДатаПо) Тогда
		Тело.Вставить("date_to", ДатаПо);
	КонецЕсли;
	Если Не ПустаяСтрока(Уровень) Тогда
		Тело.Вставить("level", Уровень);
	КонецЕсли;
	Если Не ПустаяСтрока(ПользовательЖурнала) Тогда
		Тело.Вставить("user", ПользовательЖурнала);
	КонецЕсли;
	Если Не ПустаяСтрока(Событие) Тогда
		Тело.Вставить("event", Событие);
	КонецЕсли;
	Если Не ПустаяСтрока(МетаданныеФильтр) Тогда
		Тело.Вставить("metadata", МетаданныеФильтр);
	КонецЕсли;
	Если Не ПустаяСтрока(Подстрока) Тогда
		Тело.Вставить("contains", Подстрока);
	КонецЕсли;
	Если Лимит <> Неопределено И Лимит > 0 Тогда
		Тело.Вставить("limit", Лимит);
	КонецЕсли;

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/event-log", Тело, URL, ПользовательAuth, Пароль);

КонецФункции
