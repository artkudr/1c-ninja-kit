// cf_load_git: git → список файлов → частичная загрузка в ИБ.
// Основная конфигурация: vrunner cf load --list=...
// Расширение: Designer /LoadConfigFromFiles -listFile -Extension (у vrunner cf load нет Extension).
// Без .v8-project.json. Обязателен ibconnection (параметр / env / autumn-properties).

&ПараметрИнструмента(Имя = "SRC", Описание = "Каталог XML-выгрузки (git-репозиторий конфигурации/расширения)", Тип = "string", Обязательный = Истина)
Перем SRC;

&ПараметрИнструмента(Имя = "source", Описание = "Источник изменений: All (по умолч.) / Staged / Unstaged / Commit", Тип = "string", Обязательный = Ложь)
Перем ИсточникGit;

&ПараметрИнструмента(Имя = "commit_range", Описание = "Диапазон коммитов для source=Commit, напр. HEAD~3..HEAD", Тип = "string", Обязательный = Ложь)
Перем ДиапазонКоммитов;

&ПараметрИнструмента(Имя = "dry_run", Описание = "true — только показать список файлов, без загрузки", Тип = "boolean", Обязательный = Ложь)
Перем ТолькоСписок;

&ПараметрИнструмента(Имя = "extension", Описание = "Имя расширения (частичная загрузка через Designer -Extension)", Тип = "string", Обязательный = Ложь)
Перем ИмяРасширения;

&ПараметрИнструмента(Имя = "ibconnection", Описание = "Строка подключения ИБ (/F или /S). Иначе env / autumn-properties", Тип = "string", Обязательный = Ложь)
Перем СтрокаПодключения;

&ПараметрИнструмента(Имя = "db-user", Описание = "Пользователь ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПользовательИБ;

&ПараметрИнструмента(Имя = "db-pwd", Описание = "Пароль ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПарольИБ;

&ПараметрИнструмента(Имя = "properties", Описание = "Путь к autumn-properties.json (поиск ibconnection)", Тип = "string", Обязательный = Ложь)
Перем ПутьProperties;

&Инструмент(Имя = "cf_load_git", Описание = "Частичная загрузка изменений из Git в ИБ: git → list → vrunner cf load --list (или Designer при extension). Без ibconnection — отказ. source: All/Staged/Unstaged/Commit.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьCfLoadGit() Экспорт

	Если ПустаяСтрока(SRC) Тогда
		ВызватьИсключение "Argument 'SRC' is required";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	КаталогSrc = АбсолютныйПутьКаталога(SRC);
	Если Не ФС.КаталогСуществует(КаталогSrc) Тогда
		ВызватьИсключение "cf_load_git: каталог SRC не найден: " + SRC;
	КонецЕсли;

	Режим = НормализоватьИсточник(ИсточникGit);
	Если Режим = "Commit" И ПустаяСтрока(ДиапазонКоммитов) Тогда
		ВызватьИсключение "cf_load_git: для source=Commit нужен commit_range (напр. HEAD~3..HEAD)";
	КонецЕсли;

	Изменённые = СобратьИзменённыеФайлыGit(КаталогSrc, Режим, ДиапазонКоммитов);
	Если Изменённые.Количество() = 0 Тогда
		Возврат "No changes found";
	КонецЕсли;

	ФайлыЗагрузки = ОтобратьФайлыКонфигурации(КаталогSrc, Изменённые);
	Если ФайлыЗагрузки.Количество() = 0 Тогда
		Возврат "No configuration files found in changes (git files: " + Строка(Изменённые.Количество()) + ")";
	КонецЕсли;

	ТекстСписка = СтрСоединить(ФайлыЗагрузки, Символы.ПС);
	Заголовок = "Git changes: " + Строка(Изменённые.Количество())
		+ " file(s) → load list: " + Строка(ФайлыЗагрузки.Количество()) + Символы.ПС
		+ ТекстСписка;

	Если ТолькоСписок = Истина Тогда
		Возврат "DryRun — no changes applied" + Символы.ПС + Заголовок;
	КонецЕсли;

	Подключение = РазрешитьСтрокуПодключения();
	Если ПустаяСтрока(Подключение) Тогда
		ВызватьИсключение "cf_load_git: обязателен ibconnection — параметр, env IBCONNECTION/VRUNNER_IBCONNECTION, или autumn-properties.json (vrunner.ibconnection). Без ИБ загрузка запрещена.";
	КонецЕсли;

	Пользователь = РазрешитьПользователя();
	Пароль = РазрешитьПароль();

	ФайлСписка = ПолучитьИмяВременногоФайла("txt");
	ЗаписатьСписокФайлов(ФайлСписка, ФайлыЗагрузки);

	Попытка
		Если Не ПустаяСтрока(ИмяРасширения) Тогда
			ТекстЛога = ЗагрузитьЧерезDesignerСписком(КаталогSrc, ФайлСписка, Подключение, Пользователь, Пароль, СокрЛП(ИмяРасширения));
		Иначе
			ТекстЛога = ЗагрузитьЧерезVrunner(КаталогSrc, ФайлСписка, Подключение, Пользователь, Пароль);
		КонецЕсли;
	Исключение
		Попытка
			УдалитьФайлы(ФайлСписка);
		Исключение
			// ignore
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ФайлСписка);
	Исключение
		// ignore
	КонецПопытки;

	Возврат Заголовок + Символы.ПС + Символы.ПС + ТекстЛога;

КонецФункции

#Область GitИСписок

Функция НормализоватьИсточник(Знач Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат "All";
	КонецЕсли;
	В = ВРег(СокрЛП(Значение));
	Если В = "ALL" Тогда
		Возврат "All";
	ИначеЕсли В = "STAGED" Тогда
		Возврат "Staged";
	ИначеЕсли В = "UNSTAGED" Тогда
		Возврат "Unstaged";
	ИначеЕсли В = "COMMIT" Тогда
		Возврат "Commit";
	КонецЕсли;
	ВызватьИсключение "cf_load_git: source должен быть All/Staged/Unstaged/Commit, получено: " + Значение;

КонецФункции

Функция СобратьИзменённыеФайлыGit(КаталогSrc, Режим, Диапазон)

	Строки = Новый Массив;
	Если Режим = "Staged" Тогда
		ДобавитьСтрокиGit(Строки, КаталогSrc, "diff --cached --name-only --relative");
	ИначеЕсли Режим = "Unstaged" Тогда
		ДобавитьСтрокиGit(Строки, КаталогSrc, "diff --name-only --relative");
		ДобавитьСтрокиGit(Строки, КаталогSrc, "ls-files --others --exclude-standard");
	ИначеЕсли Режим = "Commit" Тогда
		ДобавитьСтрокиGit(Строки, КаталогSrc, "diff --name-only --relative " + СокрЛП(Диапазон));
	Иначе
		// All
		ДобавитьСтрокиGit(Строки, КаталогSrc, "diff --cached --name-only --relative");
		ДобавитьСтрокиGit(Строки, КаталогSrc, "diff --name-only --relative");
		ДобавитьСтрокиGit(Строки, КаталогSrc, "ls-files --others --exclude-standard");
	КонецЕсли;

	Уникальные = Новый Массив;
	УжеЕсть = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Норм = НормализоватьОтносительныйПуть(Стр);
		Если ПустаяСтрока(Норм) Тогда
			Продолжить;
		КонецЕсли;
		Если УжеЕсть.Получить(Норм) = Истина Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(Норм, Истина);
		Уникальные.Добавить(Норм);
	КонецЦикла;
	Возврат Уникальные;

КонецФункции

Процедура ДобавитьСтрокиGit(Приёмник, КаталогSrc, ХвостАргументов)

	ФайлЛога = ПолучитьИмяВременногоФайла("txt");
	СтрокаКоманды = "git -c core.quotePath=false -C " + Кавычки(КаталогSrc) + " " + ХвостАргументов;
	КомандаСЛогом = "cmd /c " + СтрокаКоманды + " > " + Кавычки(ФайлЛога) + " 2>&1";
	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		ВызватьИсключение "cf_load_git: не удалось запустить git: " + ОписаниеОшибки();
	КонецПопытки;

	Текст = "";
	ФС = Новый СервисФайловойСистемы();
	Попытка
		Если ФС.ФайлСуществует(ФайлЛога) Тогда
			Текст = ФС.ПрочитатьФайлКакТекст(ФайлЛога);
		КонецЕсли;
	Исключение
		Текст = "";
	КонецПопытки;
	Попытка
		УдалитьФайлы(ФайлЛога);
	Исключение
		// ignore
	КонецПопытки;

	// При отсутствии изменений git diff возвращает 0 и пустой вывод; ошибка — непустой stderr/код.
	Если КодВозврата <> 0 И Не ПустаяСтрока(Текст) И СтрНайти(ВРег(Текст), "FATAL") > 0 Тогда
		ВызватьИсключение "cf_load_git: git завершился с кодом " + Строка(КодВозврата) + Символы.ПС + Текст;
	КонецЕсли;
	Если КодВозврата <> 0 И ПустаяСтрока(Текст) Тогда
		// пустой результат при ненулевом коде — считаем «нет изменений»
		Возврат;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Стр = СокрЛП(СтрЗаменить(Часть, Символ(13), ""));
		Если Не ПустаяСтрока(Стр) Тогда
			Приёмник.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОтобратьФайлыКонфигурации(КаталогSrc, ИзменённыеФайлы)

	ФС = Новый СервисФайловойСистемы();
	Результат = Новый Массив;
	УжеЕсть = Новый Соответствие;
	КореньНорм = СтрЗаменить(КаталогSrc, "\", "/");
	Если Прав(КореньНорм, 1) = "/" Тогда
		КореньНорм = Лев(КореньНорм, СтрДлина(КореньНорм) - 1);
	КонецЕсли;

	Для Каждого ФайлОтнос Из ИзменённыеФайлы Цикл
		ФайлОтнос = НормализоватьОтносительныйПуть(ФайлОтнос);
		Если ПустаяСтрока(ФайлОтнос) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(ВРег(ФайлОтнос), "PARENTCONFIGURATIONS.BIN") Тогда
			Продолжить;
		КонецЕсли;
		Если ВРег(ФайлОтнос) = "CONFIGDUMPINFO.XML" Или СтрЗаканчиваетсяНа(ВРег(ФайлОтнос), "/CONFIGDUMPINFO.XML") Тогда
			Продолжить;
		КонецЕсли;

		ПолныйПуть = ФС.ОбъединитьПути(КаталогSrc, СтрЗаменить(ФайлОтнос, "/", "\"));

		Если СтрЗаканчиваетсяНа(ВРег(ФайлОтнос), ".XML") Тогда
			Если ФС.ФайлСуществует(ПолныйПуть) Тогда
				ДобавитьВСписокУникально(Результат, УжеЕсть, ФайлОтнос);
			КонецЕсли;
		Иначе
			ОбъектXml = XmlОбъектаИзПодфайла(ФайлОтнос);
			Если ПустаяСтрока(ОбъектXml) Тогда
				Продолжить;
			КонецЕсли;
			ПолныйXml = ФС.ОбъединитьПути(КаталогSrc, СтрЗаменить(ОбъектXml, "/", "\"));
			Если Не ФС.ФайлСуществует(ПолныйXml) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьВСписокУникально(Результат, УжеЕсть, ОбъектXml);
			Если ФС.ФайлСуществует(ПолныйПуть) Тогда
				ДобавитьВСписокУникально(Результат, УжеЕсть, ФайлОтнос);
			КонецЕсли;
			ДобавитьФайлыExtОбъекта(КаталогSrc, КореньНорм, ФайлОтнос, Результат, УжеЕсть, ФС);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция XmlОбъектаИзПодфайла(ОтносительныйПуть)

	Части = СтрРазделить(СтрЗаменить(ОтносительныйПуть, "\", "/"), "/", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Части[0] + "/" + Части[1] + ".xml";

КонецФункции

Процедура ДобавитьФайлыExtОбъекта(КаталогSrc, КореньНорм, ФайлОтнос, Результат, УжеЕсть, ФС)

	Части = СтрРазделить(СтрЗаменить(ФайлОтнос, "\", "/"), "/", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	КаталогExt = ФС.ОбъединитьПути(ФС.ОбъединитьПути(КаталогSrc, Части[0]), Части[1] + "\Ext");
	Если Не ФС.КаталогСуществует(КаталогExt) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(КаталогExt, "*", Истина);
	Для Каждого Найденный Из Найденные Цикл
		Если Найденный.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Полный = СтрЗаменить(Найденный.ПолноеИмя, "\", "/");
		Префикс = КореньНорм + "/";
		Если СтрНачинаетсяС(ВРег(Полный), ВРег(Префикс)) Тогда
			Отн = Сред(Полный, СтрДлина(Префикс) + 1);
		Иначе
			Отн = НормализоватьОтносительныйПуть(Найденный.ПолноеИмя);
		КонецЕсли;
		ДобавитьВСписокУникально(Результат, УжеЕсть, Отн);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВСписокУникально(Массив, СоответствиеУже, Значение)

	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если СоответствиеУже.Получить(Значение) = Истина Тогда
		Возврат;
	КонецЕсли;
	СоответствиеУже.Вставить(Значение, Истина);
	Массив.Добавить(Значение);

КонецПроцедуры

Функция НормализоватьОтносительныйПуть(Путь)

	Стр = СокрЛП(Строка(Путь));
	Стр = СтрЗаменить(Стр, "\", "/");
	Пока СтрНачинаетсяС(Стр, "./") Цикл
		Стр = Сред(Стр, 3);
	КонецЦикла;
	Возврат Стр;

КонецФункции

Процедура ЗаписатьСписокФайлов(ПутьФайла, Список)

	// UTF-8; платформа принимает listFile без обязательного BOM (vrunner/v8runner).
	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Первая = Истина;
	Для Каждого Стр Из Список Цикл
		Если Не Первая Тогда
			Запись.Записать(Символы.ПС);
		КонецЕсли;
		Запись.Записать(Стр);
		Первая = Ложь;
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Загрузка

Функция ЗагрузитьЧерезVrunner(КаталогSrc, ФайлСписка, Подключение, Пользователь, Пароль)

	Части = Новый Массив;
	Части.Добавить("vrunner");
	Части.Добавить("cf");
	Части.Добавить("load");
	Части.Добавить("--ibconnection");
	Части.Добавить(Кавычки(Подключение));
	Если Не ПустаяСтрока(Пользователь) Тогда
		Части.Добавить("--db-user");
		Части.Добавить(Кавычки(Пользователь));
	КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда
		Части.Добавить("--db-pwd");
		Части.Добавить(Кавычки(Пароль));
	КонецЕсли;
	Части.Добавить("--list");
	Части.Добавить(Кавычки(ФайлСписка));
	Части.Добавить(Кавычки(КаталогSrc));

	Возврат ВыполнитьВнешнююКоманду(СтрСоединить(Части, " "), "vrunner cf load");

КонецФункции

Функция ЗагрузитьЧерезDesignerСписком(КаталогSrc, ФайлСписка, Подключение, Пользователь, Пароль, Расширение)

	Платформа = НайтиИсполняемыйФайл1С();
	Если ПустаяСтрока(Платформа) Тогда
		ВызватьИсключение "cf_load_git: для extension нужен 1cv8.exe (vrunner cf load не поддерживает -Extension с list). Укажите платформу в PATH или установите 1С.";
	КонецЕсли;

	ФайлЛогаПлатформы = ПолучитьИмяВременногоФайла("txt");
	Части = Новый Массив;
	Части.Добавить(Кавычки(Платформа));
	Части.Добавить("DESIGNER");
	Части.Добавить(Подключение);
	Если Не ПустаяСтрока(Пользователь) Тогда
		Части.Добавить("/N" + Кавычки(Пользователь));
	КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда
		Части.Добавить("/P" + Кавычки(Пароль));
	КонецЕсли;
	Части.Добавить("/LoadConfigFromFiles");
	Части.Добавить(Кавычки(КаталогSrc));
	Части.Добавить("-listFile");
	Части.Добавить(Кавычки(ФайлСписка));
	Части.Добавить("-Format");
	Части.Добавить("Hierarchical");
	Части.Добавить("-partial");
	Части.Добавить("-updateConfigDumpInfo");
	Части.Добавить("-Extension");
	Части.Добавить(Кавычки(Расширение));
	Части.Добавить("/Out");
	Части.Добавить(Кавычки(ФайлЛогаПлатформы));
	Части.Добавить("/DisableStartupDialogs");

	Текст = ВыполнитьВнешнююКоманду(СтрСоединить(Части, " "), "Designer LoadConfigFromFiles");
	ФС = Новый СервисФайловойСистемы();
	ТекстПлатформы = "";
	Попытка
		Если ФС.ФайлСуществует(ФайлЛогаПлатформы) Тогда
			ТекстПлатформы = ФС.ПрочитатьФайлКакТекст(ФайлЛогаПлатформы);
		КонецЕсли;
	Исключение
		ТекстПлатформы = "";
	КонецПопытки;
	Попытка
		УдалитьФайлы(ФайлЛогаПлатформы);
	Исключение
		// ignore
	КонецПопытки;

	Если Не ПустаяСтрока(ТекстПлатформы) Тогда
		Возврат Текст + Символы.ПС + "--- Designer /Out ---" + Символы.ПС + ТекстПлатформы;
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ВыполнитьВнешнююКоманду(СтрокаКоманды, Метка)

	ФайлЛога = ПолучитьИмяВременногоФайла("txt");
	КомандаСЛогом = "cmd /c " + СтрокаКоманды + " > " + Кавычки(ФайлЛога) + " 2>&1";
	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		ВызватьИсключение "cf_load_git: не удалось запустить " + Метка + ": " + ОписаниеОшибки();
	КонецПопытки;

	ТекстЛога = "";
	ФС = Новый СервисФайловойСистемы();
	Попытка
		Если ФС.ФайлСуществует(ФайлЛога) Тогда
			ТекстЛога = ФС.ПрочитатьФайлКакТекст(ФайлЛога);
		КонецЕсли;
	Исключение
		ТекстЛога = "(лог недоступен: " + ОписаниеОшибки() + ")";
	КонецПопытки;
	Попытка
		УдалитьФайлы(ФайлЛога);
	Исключение
		// ignore
	КонецПопытки;

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "cf_load_git: " + Метка + " завершился с кодом " + Строка(КодВозврата) + Символы.ПС + ТекстЛога;
	КонецЕсли;

	Если ПустаяСтрока(ТекстЛога) Тогда
		Возврат "OK: " + Метка + " (код 0)";
	КонецЕсли;
	Возврат ТекстЛога;

КонецФункции

Функция НайтиИсполняемыйФайл1С()

	Кандидаты = Новый Массив;
	Кандидаты.Добавить("C:\Program Files\1cv8");
	Кандидаты.Добавить("C:\Program Files (x86)\1cv8");
	Лучший = "";
	ЛучшаяВерсия = "";
	Для Каждого Корень Из Кандидаты Цикл
		Ф = Новый Файл(Корень);
		Если Не Ф.Существует() Или Не Ф.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ВерсияКат Из НайтиФайлы(Корень, "*", Ложь) Цикл
			Если Не ВерсияКат.ЭтоКаталог() Тогда
				Продолжить;
			КонецЕсли;
			ПутьExe = ВерсияКат.ПолноеИмя + "\bin\1cv8.exe";
			Exe = Новый Файл(ПутьExe);
			Если Exe.Существует() Тогда
				ИмяВерсии = ВерсияКат.Имя;
				Если ПустаяСтрока(ЛучшаяВерсия) Или ИмяВерсии > ЛучшаяВерсия Тогда
					ЛучшаяВерсия = ИмяВерсии;
					Лучший = ПутьExe;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Не ПустаяСтрока(Лучший) Тогда
		Возврат Лучший;
	КонецЕсли;

	// fallback: PATH
	ФайлЛога = ПолучитьИмяВременногоФайла("txt");
	КомандаСЛогом = "cmd /c where 1cv8.exe > " + Кавычки(ФайлЛога) + " 2>&1";
	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		Возврат "";
	КонецПопытки;
	ФС = Новый СервисФайловойСистемы();
	Текст = "";
	Попытка
		Если ФС.ФайлСуществует(ФайлЛога) Тогда
			Текст = ФС.ПрочитатьФайлКакТекст(ФайлЛога);
		КонецЕсли;
	Исключение
		Текст = "";
	КонецПопытки;
	Попытка
		УдалитьФайлы(ФайлЛога);
	Исключение
		// ignore
	КонецПопытки;
	Если КодВозврата = 0 И Не ПустаяСтрока(Текст) Тогда
		Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
		Если Строки.Количество() > 0 Тогда
			Возврат СокрЛП(СтрЗаменить(Строки[0], Символ(13), ""));
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область ПодключениеИХелперы

Функция РазрешитьСтрокуПодключения()

	Если Не ПустаяСтрока(СтрокаПодключения) Тогда
		Возврат СокрЛП(СтрокаПодключения);
	КонецЕсли;

	ИзEnv = ПолучитьПеременнуюСреды("IBCONNECTION");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_IBCONNECTION");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;

	Возврат ПрочитатьИзProperties("ibconnection");

КонецФункции

Функция РазрешитьПользователя()

	Если Не ПустаяСтрока(ПользовательИБ) Тогда
		Возврат СокрЛП(ПользовательИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBUSER");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBUSER");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-user");

КонецФункции

Функция РазрешитьПароль()

	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Возврат СокрЛП(ПарольИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBPWD");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBPWD");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-pwd");

КонецФункции

Функция ПрочитатьИзProperties(ИмяКлюча)

	Путь = ПутьКProperties();
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.ФайлСуществует(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ФС.ПрочитатьФайлКакТекст(Путь);
	Маркер = """" + ИмяКлюча + """";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + СтрДлина(Маркер));
	ПозДвоеточия = СтрНайти(Хвост, ":");
	Если ПозДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(Хвост, ПозДвоеточия + 1));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		ПозКонца = СтрНайти(Хвост, """");
		Если ПозКонца = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат Сред(Хвост, 1, ПозКонца - 1);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПутьКProperties()

	Если Не ПустаяСтрока(ПутьProperties) Тогда
		Возврат СокрЛП(ПутьProperties);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("AUTUMN_PROPERTIES");
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	ФС = Новый СервисФайловойСистемы();
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("autumn-properties.json");
	Кандидаты.Добавить(ФС.ОбъединитьПути(ТекущийКаталог(), "autumn-properties.json"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ФС.ФайлСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция АбсолютныйПутьКаталога(Путь)

	Ф = Новый Файл(Путь);
	Если Ф.Существует() Тогда
		Возврат Ф.ПолноеИмя;
	КонецЕсли;
	Возврат Путь;

КонецФункции

Функция Кавычки(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции

#КонецОбласти
