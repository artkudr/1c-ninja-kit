// Общие хелперы файловой системы. Не инструмент (без &Инструмент).

Функция ПрочитатьФайлКакТекст(ПутьКФайлу) Экспорт
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Текст = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция КаталогСуществует(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Возврат Ф.Существует() И Ф.ЭтоКаталог();
КонецФункции

Функция ФайлСуществует(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Возврат Ф.Существует() И Не Ф.ЭтоКаталог();
КонецФункции

Функция ОбъединитьПути(Часть1, Часть2) Экспорт
	Если ПустаяСтрока(Часть2) Тогда
		Возврат Часть1;
	КонецЕсли;
	Если ПустаяСтрока(Часть1) Тогда
		Возврат Часть2;
	КонецЕсли;
	Если Прав(Часть1, 1) = "\" Или Прав(Часть1, 1) = "/" Тогда
		Возврат Часть1 + Часть2;
	КонецЕсли;
	Возврат Часть1 + "/" + Часть2;
КонецФункции

// Массив структур {Имя, ПолныйПуть, ОтносительныйПуть, ЭтоКаталог}. 0 — только корень, 1 — +1 уровень и т.д.
Функция ПолучитьСписокЭлементов(ПутьКаталога, МаксГлубина = 0) Экспорт
	Результат = Новый Массив;
	ДобавитьЭлементыУровня(ПутьКаталога, "", 0, МаксГлубина, Результат);
	Возврат Результат;
КонецФункции

Процедура ДобавитьЭлементыУровня(Корень, ОтносительныйПуть, ТекущаяГлубина, МаксГлубина, Результат)
	Каталог = Новый Файл(ОбъединитьПути(Корень, ОтносительныйПуть));
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
		Возврат;
	КонецЕсли;
	НайденныеФайлы = НайтиФайлы(Каталог.ПолноеИмя, "*", Ложь);
	Для Каждого Найденный Из НайденныеФайлы Цикл
		ПолныйПуть = Найденный.ПолноеИмя;
		ИмяЭлемента = Найденный.Имя;
		ОтнПуть = ?(ПустаяСтрока(ОтносительныйПуть), ИмяЭлемента, ОтносительныйПуть + "/" + ИмяЭлемента);
		ЭтоКаталог = Найденный.ЭтоКаталог();
		Результат.Добавить(Новый Структура("Имя, ПолныйПуть, ОтносительныйПуть, ЭтоКаталог", ИмяЭлемента, ПолныйПуть, ОтнПуть, ЭтоКаталог));
		Если ЭтоКаталог И ТекущаяГлубина < МаксГлубина Тогда
			ДобавитьЭлементыУровня(Корень, ОтнПуть, ТекущаяГлубина + 1, МаксГлубина, Результат);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры