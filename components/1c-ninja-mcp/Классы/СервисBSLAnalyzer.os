// HTTP-клиент к HTTP-сервису расширения NinjaLive (/hs/ninja-live).
// Не инструмент (без &Инструмент). Конфиг: параметр → env NINJA_* (fallback BSL_ANALYZER_*).

#Использовать 1connector

// Выполняет GET к относительному пути сервиса. Возвращает тело ответа (строка).
//
// Параметры:
//   ОтносительныйПуть - Строка - например "/version"
//   БазовыйURL        - Строка - перекрывает env NINJA_URL
//   Пользователь      - Строка - перекрывает env NINJA_USER
//   Пароль            - Строка - перекрывает env NINJA_PASSWORD
//
Функция ВыполнитьGET(ОтносительныйПуть, БазовыйURL = "", Пользователь = "", Пароль = "") Экспорт

	URL = СобратьURL(ОтносительныйПуть, БазовыйURL);
	ДопПараметры = ПодготовитьДопПараметры(Пользователь, Пароль);
	Ответ = КоннекторHTTP.Get(URL, Неопределено, ДопПараметры);
	Возврат ОбработатьОтвет(Ответ);

КонецФункции

// Выполняет POST с JSON-телом. Возвращает тело ответа (строка).
//
// Параметры:
//   ОтносительныйПуть - Строка - например "/query"
//   Тело              - Структура, Соответствие - сериализуется в JSON
//   БазовыйURL        - Строка
//   Пользователь      - Строка
//   Пароль            - Строка
//
Функция ВыполнитьPOST(ОтносительныйПуть, Тело, БазовыйURL = "", Пользователь = "", Пароль = "") Экспорт

	URL = СобратьURL(ОтносительныйПуть, БазовыйURL);
	ДопПараметры = ПодготовитьДопПараметры(Пользователь, Пароль);
	Ответ = КоннекторHTTP.Post(URL, Неопределено, Тело, ДопПараметры);
	Возврат ОбработатьОтвет(Ответ);

КонецФункции

Функция СобратьURL(ОтносительныйПуть, БазовыйURL)

	База = СокрЛП(БазовыйURL);
	Если ПустаяСтрока(База) Тогда
		База = ЗначениеСреды("NINJA_URL", "BSL_ANALYZER_URL");
	КонецЕсли;
	Если ПустаяСтрока(База) Тогда
		ВызватьИсключение "Не задан URL HTTP-сервиса NinjaLive: параметр url или env NINJA_URL.";
	КонецЕсли;

	Пока Прав(База, 1) = "/" Цикл
		База = Лев(База, СтрДлина(База) - 1);
	КонецЦикла;

	Путь = СокрЛП(ОтносительныйПуть);
	Если ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Относительный путь HTTP-сервиса не задан.";
	КонецЕсли;
	Если Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;

	Возврат База + Путь;

КонецФункции

Функция ПодготовитьДопПараметры(Пользователь, Пароль)

	ИмяПользователя = СокрЛП(Пользователь);
	Если ПустаяСтрока(ИмяПользователя) Тогда
		ИмяПользователя = ЗначениеСреды("NINJA_USER", "BSL_ANALYZER_USER");
	КонецЕсли;

	ПарольПользователя = Пароль;
	Если ПарольПользователя = Неопределено Или ПустаяСтрока(ПарольПользователя) Тогда
		ПарольПользователя = ЗначениеСреды("NINJA_PASSWORD", "BSL_ANALYZER_PASSWORD");
	КонецЕсли;

	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Таймаут", 60);

	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		Аутентификация = Новый Структура("Пользователь, Пароль", ИмяПользователя, ПарольПользователя);
		ДопПараметры.Вставить("Аутентификация", Аутентификация);
	КонецЕсли;

	Возврат ДопПараметры;

КонецФункции

Функция ЗначениеСреды(ОсновноеИмя, УстаревшееИмя)

	Значение = ПолучитьПеременнуюСреды(ОсновноеИмя);
	Если Значение <> Неопределено И Не ПустаяСтрока(СокрЛП(Значение)) Тогда
		Возврат СокрЛП(Значение);
	КонецЕсли;

	Значение = ПолучитьПеременнуюСреды(УстаревшееИмя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значение);

КонецФункции

Функция ОбработатьОтвет(Ответ)

	ТекстОтвета = Ответ.Текст();
	Если ТекстОтвета = Неопределено Тогда
		ТекстОтвета = "";
	КонецЕсли;

	КодСостояния = Ответ.КодСостояния;
	Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("HTTP %1: %2", КодСостояния, ТекстОтвета);
	КонецЕсли;

	Возврат ТекстОтвета;

КонецФункции

// Разбирает строку JSON в значение 1С (Структура/Массив/…).
Функция РазобратьJSON(СтрокаJSON) Экспорт

	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;

КонецФункции
