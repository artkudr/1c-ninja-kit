// live_query: выполнение SELECT-запроса в живой ИБ (POST /query).

&ПараметрИнструмента(Имя = "query", Описание = "Текст запроса 1С (только ВЫБРАТЬ/SELECT)", Тип = "string", Обязательный = Истина)
Перем ТекстЗапроса;

&ПараметрИнструмента(Имя = "limit", Описание = "Максимум строк (по умолчанию на стороне сервиса 100, макс 1000)", Тип = "integer", Обязательный = Ложь)
Перем Лимит;

&ПараметрИнструмента(Имя = "parameters", Описание = "Параметры запроса как JSON-объект строкой", Тип = "string", Обязательный = Ложь)
Перем ПараметрыJSON;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_query", Описание = "Выполнить запрос к живой ИБ через NinjaLive (POST /query). Только SELECT. JSON: columns, rows, total, truncated.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveQuery() Экспорт

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "Параметр query обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("query", ТекстЗапроса);
	Если Лимит <> Неопределено И Лимит > 0 Тогда
		Тело.Вставить("limit", Лимит);
	КонецЕсли;

	Клиент = Новый СервисBSLAnalyzer();
	Если Не ПустаяСтрока(ПараметрыJSON) Тогда
		ПараметрыЗапроса = Клиент.РазобратьJSON(ПараметрыJSON);
		Если ПараметрыЗапроса <> Неопределено Тогда
			Тело.Вставить("parameters", ПараметрыЗапроса);
		КонецЕсли;
	КонецЕсли;

	Возврат Клиент.ВыполнитьPOST("/query", Тело, URL, Пользователь, Пароль);

КонецФункции
