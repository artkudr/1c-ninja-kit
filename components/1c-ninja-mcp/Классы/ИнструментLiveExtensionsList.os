// live_extensions_list: список расширений живой ИБ (POST /extensions-list).

&ПараметрИнструмента(Имя = "name_mask", Описание = "Подстрока имени или синонима (без учёта регистра)", Тип = "string", Обязательный = Ложь)
Перем МаскаИмени;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_extensions_list", Описание = "Список расширений живой ИБ (POST /extensions-list). JSON: items, returned. Опц. name_mask.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveExtensionsList() Экспорт

	Тело = Новый Структура;
	Если Не ПустаяСтрока(МаскаИмени) Тогда
		Тело.Вставить("name_mask", МаскаИмени);
	КонецЕсли;

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/extensions-list", Тело, URL, Пользователь, Пароль);

КонецФункции
