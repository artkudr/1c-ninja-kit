// bsl_search: поиск по BSL-файлам. Результат: путь:номер:фрагмент. useRegex=true — regex.

&ПараметрИнструмента(Имя = "path", Описание = "Корень выгрузки (каталог с BSL-файлами)", Тип = "string", Обязательный = Истина)
Перем Путь;

&ПараметрИнструмента(Имя = "query", Описание = "Строка или регулярное выражение для поиска", Тип = "string", Обязательный = Истина)
Перем Запрос;

&ПараметрИнструмента(Имя = "useRegex", Описание = "true — query как регулярное выражение, false — поиск подстроки (по умолчанию)", Тип = "boolean", Обязательный = Ложь)
Перем ИспользоватьRegex;

&Инструмент(Имя = "bsl_search", Описание = "Поиск текста или регулярного выражения по BSL-файлам в каталоге. Формат результата: путь:номер:фрагмент. UTF-8.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьПоискBSL() Экспорт

	Если ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Argument 'path' is required";
	КонецЕсли;
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Argument 'query' is required";
	КонецЕсли;
	Если ИспользоватьRegex = Неопределено Тогда
		ИспользоватьRegex = Ложь;
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	РегулярноеВыражение = Неопределено;
	Если ИспользоватьRegex Тогда
		Попытка
			РегулярноеВыражение = Новый РегулярноеВыражение(Запрос);
		Исключение
			ВызватьИсключение "Недопустимое регулярное выражение: " + ОписаниеОшибки();
		КонецПопытки;
	КонецЕсли;

	Если Не ФС.КаталогСуществует(Путь) Тогда
		ВызватьИсключение "Directory not found: " + Путь;
	КонецЕсли;

	ФайлыBsl = НайтиФайлы(Путь, "*.bsl", Истина);
	Результат = Новый Массив;
	Для Каждого ФайлИнфо Из ФайлыBsl Цикл
		Если ФайлИнфо.ЭтоКаталог() Тогда Продолжить; КонецЕсли;
		ПолныйПуть = ФайлИнфо.ПолноеИмя;
		ТекстФайла = ФС.ПрочитатьФайлКакТекст(ПолныйПуть);
		Строки = СтрРазделить(ТекстФайла, Символ(10), Ложь);
		НомерСтроки = 0;
		Для Каждого СтрокаТекста Из Строки Цикл
			НомерСтроки = НомерСтроки + 1;
			Совпадает = Ложь;
			Если ИспользоватьRegex Тогда
				Совпадает = РегулярноеВыражение.Совпадает(СтрокаТекста);
			Иначе
				Совпадает = (СтрНайти(СтрокаТекста, Запрос) > 0);
			КонецЕсли;
			Если Совпадает Тогда
				Результат.Добавить(ПолныйПуть + ":" + Формат(НомерСтроки, "ЧГ=0") + ":" + СтрокаТекста);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(Результат, Символ(10));

КонецФункции