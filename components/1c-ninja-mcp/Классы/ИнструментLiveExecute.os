// live_execute: выполнение BSL-кода в живой ИБ (POST /execute). Нужна роль NinjaLive_ВыполнениеКода.

&ПараметрИнструмента(Имя = "code", Описание = "BSL-код (операторы). Результат кладите в переменную Контекст", Тип = "string", Обязательный = Истина)
Перем Код;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_execute", Описание = "Выполнить BSL-код в живой ИБ (POST /execute). Опасная операция; нужна роль NinjaLive_ВыполнениеКода. JSON: success, context, duration_ms.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveExecute() Экспорт

	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "Параметр code обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("code", Код);

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/execute", Тело, URL, Пользователь, Пароль);

КонецФункции
