// live_check_syntax: проверка синтаксиса BSL-кода (POST /check-syntax).

&ПараметрИнструмента(Имя = "code", Описание = "Фрагмент BSL-кода для проверки синтаксиса", Тип = "string", Обязательный = Истина)
Перем Код;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_check_syntax", Описание = "Проверить синтаксис BSL-кода в живой ИБ без выполнения (POST /check-syntax). JSON: valid, error.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveCheckSyntax() Экспорт

	Если ПустаяСтрока(Код) Тогда
		ВызватьИсключение "Параметр code обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("code", Код);

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/check-syntax", Тело, URL, Пользователь, Пароль);

КонецФункции
