// live_metadata_structure: структура объекта метаданных (POST /metadata-structure).

&ПараметрИнструмента(Имя = "meta_type", Описание = "Имя коллекции метаданных, например Справочники, Документы", Тип = "string", Обязательный = Истина)
Перем ТипМетаданных;

&ПараметрИнструмента(Имя = "name", Описание = "Имя объекта в коллекции", Тип = "string", Обязательный = Истина)
Перем ИмяОбъекта;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_metadata_structure", Описание = "Структура объекта метаданных живой ИБ (POST /metadata-structure): реквизиты, ТЧ и т.п.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveMetadataStructure() Экспорт

	Если ПустаяСтрока(ТипМетаданных) Тогда
		ВызватьИсключение "Параметр meta_type обязателен и не должен быть пустым.";
	КонецЕсли;
	Если ПустаяСтрока(ИмяОбъекта) Тогда
		ВызватьИсключение "Параметр name обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("meta_type", ТипМетаданных);
	Тело.Вставить("name", ИмяОбъекта);

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/metadata-structure", Тело, URL, Пользователь, Пароль);

КонецФункции
