// syntax_help_search: справка синтакс-помощника в SQLite (таблица nodes). Пакет sql.
// Путь к БД: dbPath → env SHCNTX_HELP_DB → shcntx_help_db_path.txt → src/data/shcntx_help.db.

#Использовать sql

&ПараметрИнструмента(Имя = "query", Описание = "Строка поиска по справке (name/content)", Тип = "string", Обязательный = Истина)
Перем ЗапросСтрока;

&ПараметрИнструмента(Имя = "dbPath", Описание = "Путь к SQLite-базе справки (по умолчанию: env SHCNTX_HELP_DB, затем shcntx_help_db_path.txt, затем src/data/shcntx_help.db)", Тип = "string", Обязательный = Ложь)
Перем ПутьБД;

&ПараметрИнструмента(Имя = "limit", Описание = "Количество записей (по умолчанию 20)", Тип = "integer", Обязательный = Ложь)
Перем Лимит;

&ПараметрИнструмента(Имя = "snippet_length", Описание = "Длина фрагмента контента в символах (по умолчанию 200)", Тип = "integer", Обязательный = Ложь)
Перем ДлинаФрагмента;

&Инструмент(Имя = "syntax_help_search", Описание = "Поиск по справке синтакс-помощника 1С в SQLite-БД (таблица nodes). Возвращает имя и фрагмент описания.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьSyntaxHelpSearch() Экспорт

	Если ПустаяСтрока(ЗапросСтрока) Тогда
		ВызватьИсключение "Параметр query обязателен и не должен быть пустым.";
	КонецЕсли;
	Если Лимит = Неопределено Тогда
		Лимит = 20;
	ИначеЕсли Лимит < 1 Тогда
		ВызватьИсключение "Параметр limit должен быть не менее 1.";
	КонецЕсли;
	Если ДлинаФрагмента = Неопределено Тогда
		ДлинаФрагмента = 200;
	КонецЕсли;

	Если ПустаяСтрока(ПутьБД) Тогда
		ПутьБД = РазрешитьПутьКБД();
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.ФайлСуществует(ПутьБД) Тогда
		ВызватьИсключение "База справки не найдена: " + ПутьБД;
	КонецЕсли;

	Соединение = Новый Соединение();
	Соединение.ТипСУБД = Соединение.ТипыСУБД.sqlite;
	Соединение.ИмяБазы = ПутьБД;
	Соединение.Открыть();

	Выборка = Неопределено;
	Попытка
		Запрос = Новый Запрос();
		Запрос.УстановитьСоединение(Соединение);
		Запрос.Текст = "SELECT id, name, path, content FROM nodes WHERE (name LIKE @pat OR (content IS NOT NULL AND content LIKE @pat)) LIMIT @limit";
		Запрос.УстановитьПараметр("pat", "%" + ЗапросСтрока + "%");
		Запрос.УстановитьПараметр("limit", Лимит);
		Выборка = Запрос.Выполнить().Выгрузить();
	Исключение
		Попытка Соединение.Закрыть(); Исключение КонецПопытки;
		ВызватьИсключение "Ошибка запроса к БД: " + ОписаниеОшибки();
	КонецПопытки;
	Соединение.Закрыть();

	Если Выборка.Количество() = 0 Тогда
		Возврат "Совпадений не найдено.";
	КонецЕсли;

	СтрокиРезультата = Новый Массив;
	Для Каждого Строка Из Выборка Цикл
		Имя = Строка.name;
		Контент = Строка.content;
		Если Контент = Неопределено Или ПустаяСтрока(Контент) Тогда
			СтрокиРезультата.Добавить(Имя);
		Иначе
			Фрагмент = СжатьКонтент(Контент, Имя, ДлинаФрагмента);
			СтрокиРезультата.Добавить(Имя + ": " + Фрагмент);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(СтрокиРезультата, Символ(10));

КонецФункции

// Убирает BOM, дублирующиеся строки и пустые строки; возвращает первые значимые строки до MaxLen символов.
Функция СжатьКонтент(Контент, Имя, МаксДлина)
	Текст = СтрЗаменить(Контент, Символ(65279), "");
	Строки = СтрРазделить(Текст, Символ(10), Ложь);
	Уникальные = Новый Массив;
	УжеДобавлены = Новый Соответствие;
	Для Каждого Стр Из Строки Цикл
		Стр = СокрЛП(Стр);
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;
		Если Стр = Имя Тогда
			Продолжить;
		КонецЕсли;
		Если УжеДобавлены[Стр] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(Стр, Истина);
		Уникальные.Добавить(Стр);
	КонецЦикла;
	Результат = "";
	Для Каждого Стр Из Уникальные Цикл
		Если ПустаяСтрока(Результат) Тогда
			Результат = Стр;
		Иначе
			Результат = Результат + " | " + Стр;
		КонецЕсли;
		Если СтрДлина(Результат) >= МаксДлина Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Результат) > МаксДлина Тогда
		Результат = Лев(Результат, МаксДлина) + "...";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РазрешитьПутьКБД()
	ПутьИзОкружения = ПолучитьПеременнуюСреды("SHCNTX_HELP_DB");
	Если Не ПустаяСтрока(ПутьИзОкружения) Тогда
		Возврат ПутьИзОкружения;
	КонецЕсли;

	ФайлДефолта = Новый Файл(ТекущийКаталог() + "/shcntx_help_db_path.txt");
	Если ФайлДефолта.Существует() Тогда
		Попытка
			Чтение = Новый ЧтениеТекста(ФайлДефолта.ПолноеИмя, КодировкаТекста.UTF8);
			ПутьИзФайла = СокрЛП(Чтение.Прочитать());
			Чтение.Закрыть();
			Если Не ПустаяСтрока(ПутьИзФайла) Тогда
				Возврат ПутьИзФайла;
			КонецЕсли;
		Исключение
			// оставляем fallback ниже
		КонецПопытки;
	КонецЕсли;

	Возврат "src/data/shcntx_help.db";
КонецФункции