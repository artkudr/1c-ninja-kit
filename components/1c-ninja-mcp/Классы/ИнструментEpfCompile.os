// epf_compile: pre-check (modules/handlers как epf-build) + сборка через vrunner epf compile.
// Обязателен ibconnection (параметр / env / autumn-properties). Пустая temp-ИБ для сборки запрещена.
// Pre-check поднимает отдельную stub-ИБ только для /CheckConfig (как апстрим epf-build), файл .epf не пишет.

&ПараметрИнструмента(Имя = "SRC", Описание = "Каталог исходников обработки/отчёта или корневой .xml", Тип = "string", Обязательный = Истина)
Перем SRC;

&ПараметрИнструмента(Имя = "out", Описание = "Каталог для собранных .epf/.erf", Тип = "string", Обязательный = Ложь)
Перем КаталогВывода;

&ПараметрИнструмента(Имя = "checks", Описание = "Pre-check до сборки: modules,handlers,unreferenced,empty-handlers,config; off — без проверки. По умолчанию modules,handlers", Тип = "string", Обязательный = Ложь)
Перем Checks;

&ПараметрИнструмента(Имя = "context", Описание = "Контексты для checks=modules (через запятую). По умолчанию ThinClient,Server", Тип = "string", Обязательный = Ложь)
Перем Context;

&ПараметрИнструмента(Имя = "recursive", Описание = "Рекурсивный поиск обработок/отчётов (флаг vrunner)", Тип = "boolean", Обязательный = Ложь)
Перем Рекурсивно;

&ПараметрИнструмента(Имя = "ibconnection", Описание = "Строка подключения ИБ (/F или /S). Иначе env / autumn-properties", Тип = "string", Обязательный = Ложь)
Перем СтрокаПодключения;

&ПараметрИнструмента(Имя = "db-user", Описание = "Пользователь ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПользовательИБ;

&ПараметрИнструмента(Имя = "db-pwd", Описание = "Пароль ИБ (иначе env / properties)", Тип = "string", Обязательный = Ложь)
Перем ПарольИБ;

&ПараметрИнструмента(Имя = "properties", Описание = "Путь к autumn-properties.json (поиск ibconnection)", Тип = "string", Обязательный = Ложь)
Перем ПутьProperties;

&Инструмент(Имя = "epf_compile", Описание = "Собрать EPF/ERF из исходников: pre-check (modules/handlers, stub+/CheckConfig) затем vrunner epf compile. Без ibconnection (параметр, env IBCONNECTION/VRUNNER_IBCONNECTION или autumn-properties.json) — отказ; пустая temp-ИБ для сборки не создаётся.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьEpfCompile() Экспорт

	Если ПустаяСтрока(SRC) Тогда
		ВызватьИсключение "Argument 'SRC' is required";
	КонецЕсли;

	Подключение = РазрешитьСтрокуПодключения();
	Если ПустаяСтрока(Подключение) Тогда
		ВызватьИсключение "epf_compile: обязателен ibconnection — параметр, env IBCONNECTION/VRUNNER_IBCONNECTION, или autumn-properties.json (vrunner.ibconnection). Без ИБ сборка запрещена (пустая temp не используется).";
	КонецЕсли;

	Пользователь = РазрешитьПользователя();
	Пароль = РазрешитьПароль();

	ЛогПроверки = ВыполнитьPreCheck();
	ЛогСборки = ВыполнитьVrunnerCompile(Подключение, Пользователь, Пароль);

	ЧастиОтвета = Новый Массив;
	Если Не ПустаяСтрока(ЛогПроверки) Тогда
		ЧастиОтвета.Добавить("--- epf-precheck ---");
		ЧастиОтвета.Добавить(ЛогПроверки);
	КонецЕсли;
	ЧастиОтвета.Добавить("--- vrunner epf compile ---");
	ЧастиОтвета.Добавить(ЛогСборки);
	Возврат СтрСоединить(ЧастиОтвета, Символы.ПС);

КонецФункции

Функция ВыполнитьPreCheck()

	СписокПроверок = НормализоватьChecks();
	Если СписокПроверок = "off" Тогда
		Возврат "checks=off — pre-check пропущен";
	КонецЕсли;

	Скрипт = ПутьСкриптаPreCheck();
	Если ПустаяСтрока(Скрипт) Тогда
		ВызватьИсключение "epf_compile: не найден scripts/epf-precheck.ps1 рядом с сервером";
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить("powershell.exe");
	Части.Добавить("-NoProfile");
	Части.Добавить("-File");
	Части.Добавить(Кавычки(Скрипт));
	Части.Добавить("-SRC");
	Части.Добавить(Кавычки(SRC));
	Части.Добавить("-Checks");
	Части.Добавить(Кавычки(СписокПроверок));
	Если Не ПустаяСтрока(Context) Тогда
		Части.Добавить("-Context");
		Части.Добавить(Кавычки(СокрЛП(Context)));
	КонецЕсли;

	Возврат ЗапуститьИСобратьЛог(СтрСоединить(Части, " "), "epf-precheck");

КонецФункции

Функция ВыполнитьVrunnerCompile(Подключение, Пользователь, Пароль)

	Части = Новый Массив;
	Части.Добавить("vrunner");
	Части.Добавить("epf");
	Части.Добавить("compile");
	Части.Добавить("--ibconnection");
	Части.Добавить(Кавычки(Подключение));
	Если Не ПустаяСтрока(Пользователь) Тогда
		Части.Добавить("--db-user");
		Части.Добавить(Кавычки(Пользователь));
	КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда
		Части.Добавить("--db-pwd");
		Части.Добавить(Кавычки(Пароль));
	КонецЕсли;
	Части.Добавить("--SRC");
	Части.Добавить(Кавычки(SRC));
	Если Не ПустаяСтрока(КаталогВывода) Тогда
		Части.Добавить("--out");
		Части.Добавить(Кавычки(КаталогВывода));
	КонецЕсли;
	Если Рекурсивно = Истина Тогда
		Части.Добавить("--recursive");
	КонецЕсли;

	Возврат ЗапуститьИСобратьЛог(СтрСоединить(Части, " "), "vrunner epf compile");

КонецФункции

Функция НормализоватьChecks()

	Сырое = СокрЛП(Checks);
	Если ПустаяСтрока(Сырое) Тогда
		Возврат "modules,handlers";
	КонецЕсли;
	Низ = НРег(Сырое);
	Если Низ = "off" Или Низ = "false" Или Низ = "0" Или Низ = "нет" Тогда
		Возврат "off";
	КонецЕсли;
	Возврат Сырое;

КонецФункции

Функция ПутьСкриптаPreCheck()

	ФС = Новый СервисФайловойСистемы();
	Кандидаты = Новый Массив;

	Попытка
		Инфо = СтартовыйСценарий();
		КатСервера = Новый Файл(Инфо.Источник).Путь;
		Кандидаты.Добавить(ФС.ОбъединитьПути(ФС.ОбъединитьПути(КатСервера, "scripts"), "epf-precheck.ps1"));
	Исключение
		// ignore
	КонецПопытки;

	Кандидаты.Добавить(ФС.ОбъединитьПути(ФС.ОбъединитьПути(ТекущийКаталог(), "scripts"), "epf-precheck.ps1"));
	Кандидаты.Добавить("C:\1C\projects\1c-ninja-mcp\scripts\epf-precheck.ps1");

	Для Каждого Кандидат Из Кандидаты Цикл
		Если ФС.ФайлСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЗапуститьИСобратьЛог(СтрокаКоманды, Метка)

	ФайлЛога = ПолучитьИмяВременногоФайла("txt");
	КомандаСЛогом = "cmd /c " + СтрокаКоманды + " > " + Кавычки(ФайлЛога) + " 2>&1";

	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение(КомандаСЛогом, , Истина, КодВозврата);
	Исключение
		ВызватьИсключение "epf_compile: не удалось запустить " + Метка + ": " + ОписаниеОшибки();
	КонецПопытки;

	ТекстЛога = "";
	ФС = Новый СервисФайловойСистемы();
	Попытка
		Если ФС.ФайлСуществует(ФайлЛога) Тогда
			ТекстЛога = ФС.ПрочитатьФайлКакТекст(ФайлЛога);
		КонецЕсли;
	Исключение
		ТекстЛога = "(лог недоступен: " + ОписаниеОшибки() + ")";
	КонецПопытки;

	Попытка
		УдалитьФайлы(ФайлЛога);
	Исключение
		// ignore
	КонецПопытки;

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "epf_compile: " + Метка + " завершился с кодом " + Строка(КодВозврата) + Символы.ПС + ТекстЛога;
	КонецЕсли;

	Если ПустаяСтрока(ТекстЛога) Тогда
		Возврат "OK: " + Метка + " (код 0), SRC=" + SRC;
	КонецЕсли;
	Возврат ТекстЛога;

КонецФункции

Функция РазрешитьСтрокуПодключения()

	Если Не ПустаяСтрока(СтрокаПодключения) Тогда
		Возврат СокрЛП(СтрокаПодключения);
	КонецЕсли;

	ИзEnv = ПолучитьПеременнуюСреды("IBCONNECTION");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_IBCONNECTION");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;

	Возврат ПрочитатьИзProperties("ibconnection");

КонецФункции

Функция РазрешитьПользователя()

	Если Не ПустаяСтрока(ПользовательИБ) Тогда
		Возврат СокрЛП(ПользовательИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBUSER");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBUSER");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-user");

КонецФункции

Функция РазрешитьПароль()

	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Возврат СокрЛП(ПарольИБ);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("VRUNNER_DBPWD");
	Если ПустаяСтрока(ИзEnv) Тогда
		ИзEnv = ПолучитьПеременнуюСреды("DBPWD");
	КонецЕсли;
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	Возврат ПрочитатьИзProperties("db-pwd");

КонецФункции

Функция ПрочитатьИзProperties(ИмяКлюча)

	Путь = ПутьКProperties();
	Если ПустаяСтрока(Путь) Тогда
		Возврат "";
	КонецЕсли;

	ФС = Новый СервисФайловойСистемы();
	Если Не ФС.ФайлСуществует(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Текст = ФС.ПрочитатьФайлКакТекст(Путь);
	Маркер = """" + ИмяКлюча + """";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Поз + СтрДлина(Маркер));
	ПозДвоеточия = СтрНайти(Хвост, ":");
	Если ПозДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = СокрЛП(Сред(Хвост, ПозДвоеточия + 1));
	Если СтрНачинаетсяС(Хвост, """") Тогда
		Хвост = Сред(Хвост, 2);
		ПозКонца = СтрНайти(Хвост, """");
		Если ПозКонца = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат Сред(Хвост, 1, ПозКонца - 1);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПутьКProperties()

	Если Не ПустаяСтрока(ПутьProperties) Тогда
		Возврат СокрЛП(ПутьProperties);
	КонецЕсли;
	ИзEnv = ПолучитьПеременнуюСреды("AUTUMN_PROPERTIES");
	Если Не ПустаяСтрока(ИзEnv) Тогда
		Возврат СокрЛП(ИзEnv);
	КонецЕсли;
	ФС = Новый СервисФайловойСистемы();
	Кандидаты = Новый Массив;
	Кандидаты.Добавить("autumn-properties.json");
	Кандидаты.Добавить(ФС.ОбъединитьПути(ТекущийКаталог(), "autumn-properties.json"));
	Для Каждого Кандидат Из Кандидаты Цикл
		Если ФС.ФайлСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Кавычки(Значение)

	Возврат """" + Строка(Значение) + """";

КонецФункции
