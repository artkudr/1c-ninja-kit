// live_metadata_list: список объектов коллекции метаданных (POST /metadata-list).

&ПараметрИнструмента(Имя = "meta_type", Описание = "Имя коллекции метаданных, например Справочники, Документы, РегистрыСведений", Тип = "string", Обязательный = Истина)
Перем ТипМетаданных;

&ПараметрИнструмента(Имя = "name_mask", Описание = "Подстрока имени (без учёта регистра)", Тип = "string", Обязательный = Ложь)
Перем МаскаИмени;

&ПараметрИнструмента(Имя = "limit", Описание = "Максимум элементов (по умолчанию 100, макс 1000)", Тип = "integer", Обязательный = Ложь)
Перем Лимит;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_metadata_list", Описание = "Список объектов метаданных живой ИБ (POST /metadata-list). Нужен meta_type коллекции.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveMetadataList() Экспорт

	Если ПустаяСтрока(ТипМетаданных) Тогда
		ВызватьИсключение "Параметр meta_type обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("meta_type", ТипМетаданных);
	Если Не ПустаяСтрока(МаскаИмени) Тогда
		Тело.Вставить("name_mask", МаскаИмени);
	КонецЕсли;
	Если Лимит <> Неопределено И Лимит > 0 Тогда
		Тело.Вставить("limit", Лимит);
	КонецЕсли;

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/metadata-list", Тело, URL, Пользователь, Пароль);

КонецФункции
