// live_validate_query: проверка синтаксиса запроса без выполнения (POST /validate-query).

&ПараметрИнструмента(Имя = "query", Описание = "Текст запроса 1С для проверки через СхемаЗапроса", Тип = "string", Обязательный = Истина)
Перем ТекстЗапроса;

&ПараметрИнструмента(Имя = "url", Описание = "Базовый URL сервиса (по умолчанию env NINJA_URL)", Тип = "string", Обязательный = Ложь)
Перем URL;

&ПараметрИнструмента(Имя = "user", Описание = "Пользователь ИБ (по умолчанию env NINJA_USER)", Тип = "string", Обязательный = Ложь)
Перем Пользователь;

&ПараметрИнструмента(Имя = "password", Описание = "Пароль (по умолчанию env NINJA_PASSWORD)", Тип = "string", Обязательный = Ложь)
Перем Пароль;

&Инструмент(Имя = "live_validate_query", Описание = "Проверить синтаксис запроса 1С в живой ИБ без выполнения (POST /validate-query). JSON: valid, errors.")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ВыполнениеИнструмента
Функция ВыполнитьLiveValidateQuery() Экспорт

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ВызватьИсключение "Параметр query обязателен и не должен быть пустым.";
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("query", ТекстЗапроса);

	Клиент = Новый СервисBSLAnalyzer();
	Возврат Клиент.ВыполнитьPOST("/validate-query", Тело, URL, Пользователь, Пароль);

КонецФункции
